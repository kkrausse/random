{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["bun"]
  },
  "include": ["build-android.ts", "src/**/*.ts", "scripts/**/*.ts"]
}
