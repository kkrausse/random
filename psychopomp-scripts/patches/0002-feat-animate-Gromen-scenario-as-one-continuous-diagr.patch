+        launch(&mut scene, &s, c.at(cue) + seconds(1.25), edge, to, 0.65);
+    }
+    // The same four arrows accelerate; no scene change replaces the diagram.
+    for (i, (edge, to)) in [
+        ("loop-a", "interest"),
+        ("loop-b", "deficit"),
+        ("loop-c", "issuance"),
+        ("loop-d", "yields"),
+    ]
+    .into_iter()
