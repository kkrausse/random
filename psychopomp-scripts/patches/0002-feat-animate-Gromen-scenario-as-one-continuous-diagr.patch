+        if let Some((next, _)) = captions.get(i + 1) {
+            scene.at(c.at(next) - seconds(0.16), cap.hide());
+        }
+    }
+    for (cue, edge, to) in [
+        ("fiscal", "fiscal-feed", "issuance"),
+        ("foreign", "foreign-feed", "yields"),
+        ("supply", "supply-feed", "yields"),
