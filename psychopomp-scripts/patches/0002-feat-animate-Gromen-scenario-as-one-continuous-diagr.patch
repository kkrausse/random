+                } else {
+                    scene.at(seconds(0.5), s.fade_in(id, 1.0, 0.6));
+                }
+            }
+            StageElement::Path { .. } => {
+                scene.at(0, s.channel(format!("{id}.draw"), 0.0));
+            }
+            _ => {}
+        }
+    }
+    let captions = [
+        ("intro", "ONE MACHINE"),
+        ("fiscal", "FISCAL LOAD"),
+        ("foreign", "DEMAND THINS"),
+        ("supply", "SUPPLY SQUEEZE"),
