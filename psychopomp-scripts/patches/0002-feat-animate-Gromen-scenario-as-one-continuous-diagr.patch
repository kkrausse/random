+fn text(
+    scene: &mut PlanBuilder,
+    id: &str,
+    value: &str,
+    y: f32,
+    size: f32,
+    tone: Tone,
+) -> Result<Caption> {
+    Caption::declare(
+        scene,
+        id,
+        &CaptionPlan::line([80.0, y], size, vec![CaptionSpanPlan::new(value, tone)]),
+    )
+}
+fn launch(scene: &mut PlanBuilder, s: &Stage, at: u64, edge: &str, to: &str, travel: f32) {
+    scene.at(
+        at,
+        s.connect(edge, 0.3)
+            .then(s.send(format!("p-{edge}"), travel))
+            .with(sfx::SEND.beat(format!("s-{edge}-{at}"), -20.0))
+            .then(s.land(to)),
+    );
+}
+fn amalgamate(scene: &mut PlanBuilder, s: &Stage, c: &Clip, cue: &str) {
+    let (_, destination, actors) = GROUPS.iter().find(|g| g.0 == cue).unwrap();
+    for (i, id) in actors.iter().enumerate() {
+        let el = s.plan().elements.iter().find(|el| el.id() == *id).unwrap();
+        let [x, y, _] = match el {
+            StageElement::Card { at, .. } => *at,
+            _ => unreachable!(),
+        };
+        let at = c.at(cue) + seconds(i as f64 * 0.11);
+        scene.at(
+            at,
+            s.glide(format!("{id}.x"), destination[0] - x, 1.0)
+                .also(s.glide(format!("{id}.y"), destination[1] - y, 1.0))
+                .also(s.glide(format!("{id}.scale"), 0.1, 1.0))
+                .also(s.to(format!("{id}.opacity"), 0.0, 1.0)),
+        );
+    }
+    scene.at(c.at(cue) + seconds(0.65), s.fade_in(cue, 1.0, 0.55));
+}
