+            to,
+            0.55,
+        );
+    }
+    for lap in 0..3 {
+        for (i, (edge, to)) in [
+            ("loop-a", "interest"),
+            ("loop-b", "deficit"),
+            ("loop-c", "issuance"),
+            ("loop-d", "yields"),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            launch(
+                &mut scene,
+                &s,
+                c.at("loop") + seconds(5.4 + lap as f64 * 1.4 + i as f64 * 0.35),
+                edge,
+                to,
+                0.35,
+            );
+        }
+    }
+    scene.at(c.at("loop"), s.charge("core", 0.9, 7.0));
+    scene.at(c.at("loop"), s.to("camera.zoom", 1.05, 3.0));
+    launch(&mut scene, &s, c.at("crisis"), "impact", "core", 0.6);
+    let boom = c.end("crisis") + seconds(0.12);
+    scene.at(
+        boom.saturating_sub(sfx::RISER.length()),
+        sfx::RISER.beat("riser", -23.0),
+    );
+    scene.at(
+        boom,
+        s.clock_for("core.burst", 5.2)
+            .with(sfx::BOOM.beat("boom", -9.0)),
+    );
+    scene.at(boom + seconds(0.12), s.jolt([0.8, -0.3], 0.65));
+    for id in ["interest", "issuance", "credit", "foreign"] {
+        scene.at(boom + seconds(0.4), s.hit(format!("{id}.damage"), 1.0, 0.4));
+    }
+    // Reconstitute the SAME Treasury orb as support enters the SAME system.
+    scene.at(c.at("rescue"), s.fade_in("fed", 1.0, 0.5));
+    launch(
+        &mut scene,
+        &s,
+        c.at("rescue") + seconds(0.6),
+        "rescue",
+        "core",
+        0.8,
+    );
+    scene.at(c.at("rescue") + seconds(1.8), s.unburst("core", 1.4));
+    scene.at(c.at("rescue") + seconds(1.8), s.charge("core", 0.0, 0.5));
+    for edge in ["loop-a", "loop-b", "loop-c", "loop-d"] {
+        scene.at(
+            c.at("rescue") + seconds(2.0),
+            s.to(format!("{edge}.opacity"), 0.22, 0.8),
+        );
+    }
+    // Keep the causal subgroups visible: park them at the perimeter rather
+    // than deleting the original pressures when the rescue arrives.
+    for (old, dx, dy) in [
+        ("fiscal", -160.0, -135.0),
+        ("foreign", 180.0, -135.0),
+        ("supply", -160.0, 155.0),
+        ("credit", 180.0, 155.0),
+    ] {
+        scene.at(
+            c.at("rescue") + seconds(2.0),
+            s.glide(format!("{old}.x"), dx, 1.0)
+                .also(s.glide(format!("{old}.y"), dy, 1.0))
+                .also(s.glide(format!("{old}.scale"), 0.65, 1.0))
+                .also(s.to(format!("{old}.opacity"), 0.5, 1.0)),
+        );
+    }
+    for id in ["reserves", "m2"] {
+        scene.at(c.at("rescue") + seconds(2.4), s.fade_in(id, 1.0, 0.7));
+    }
+    launch(
+        &mut scene,
+        &s,
+        c.at("rescue") + seconds(2.5),
+        "balance",
+        "reserves",
+        0.65,
+    );
+    launch(&mut scene, &s, c.at("caveat"), "money", "m2", 0.65);
+    for id in ["dollar", "hard"] {
+        scene.at(c.at("assets"), s.fade_in(id, 1.0, 0.7));
+    }
+    launch(
+        &mut scene,
+        &s,
+        c.at("assets") + seconds(0.7),
+        "release",
+        "dollar",
+        0.75,
+    );
+    launch(
+        &mut scene,
+        &s,
+        c.at("assets") + seconds(1.8),
+        "assets",
+        "hard",
+        0.75,
+    );
+    scene.at(
+        c.at("assets") + seconds(2.8),
+        s.land("hard").with(sfx::BLOOM.beat("bloom", -17.0)),
+    );
+    scene.at(c.at("caveat"), s.fade_in("offramp", 1.0, 0.6));
+    scene.at(c.at("caveat"), s.to("camera.zoom", 1.0, 2.0));
+    Ok(scene.finish()?)
+}
+fn main() -> Result<()> {
+    let here = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    let clips: Vec<Clip> =
+        serde_json::from_slice(&std::fs::read(here.join("narration/timeline.json"))?)?;
+    let c = &clips[0];
+    build(c)?.write_or_print(Some(here.join("continuous.json")))?;
+    let stamp = |t: f64| {
+        let ms = (t * 1000.0).round() as u64;
+        format!(
+            "{:02}:{:02}:{:02}.{:03}",
+            ms / 3600000,
+            ms / 60000 % 60,
+            ms / 1000 % 60,
+            ms % 1000
+        )
+    };
+    let vtt = "WEBVTT\n\n".to_string()
+        + &c.blocks
+            .iter()
+            .map(|b| {
+                format!(
+                    "{} --> {}\n{}\n\n",
+                    stamp(2.0 + b.start),
+                    stamp(2.0 + b.end),
+                    b.text
+                )
+            })
+            .collect::<String>();
+    std::fs::write(here.join("captions.vtt"), vtt)?;
+    println!("ONE CONTINUOUS SCENE / {:.1}s", c.duration + 5.0);
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn all_pressures_and_rescue_share_one_stage() {
+        let plan = diagram().unwrap();
+        for id in [
+            "boomers",
+            "congress",
+            "veterans",
+            "bessent",
+            "foreigners",
+            "china",
+            "debtors",
+            "iran",
+            "refiners",
+            "copper",
+            "ai",
+            "workers",
+            "banks",
+            "hedge",
+            "core",
+            "fed",
+            "reserves",
+            "m2",
+            "dollar",
+            "hard",
+        ] {
+            assert!(plan.elements.iter().any(|element| element.id() == id));
+        }
+        let clips: Vec<Clip> =
+            serde_json::from_str(include_str!("../narration/timeline.json")).unwrap();
+        assert_eq!(clips.len(), 1);
+        assert!(clips[0].duration + 5.0 < 65.0);
+        build(&clips[0]).unwrap();
+    }
+}
