+//! One scene, one diagram, no cuts: a third-person summary of Luke Gromen's
+//! argument that inflation is the only way out of the US debt.
+//!
+//! The diagram is four regions of one world, and the camera pans between them:
+//!
+//!     A  the yardstick (true interest expense vs tax receipts) and 2020-22
+//!     B  the four exits (doors); the film ends here with only door 1 lit
+//!     C  Japan vs USA
+//!     D  the strong-dollar option and the doom loop it feeds
+use anyhow::Result;
+use psychopomp::{
+    author::{PlanBuilder, seconds},
+    caption::{CaptionPlan, CaptionSpanPlan},
+    plan::{MediaKindPlan, MediaPlan, MediaRolePlan, ScenePlan},
+    score::{Beat, Caption, Stage},
+    sfx,
+    stage::{StageElement, StagePlan, StagePost},
+    tone::Tone,
+};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::path::PathBuf;
+
+#[derive(Deserialize)]
+struct Block {
+    cue: String,
+    text: String,
+    start: f64,
+    end: f64,
+}
+#[derive(Deserialize)]
+struct Clip {
+    duration: f64,
+    blocks: Vec<Block>,
+}
+impl Clip {
+    fn block(&self, cue: &str) -> &Block {
+        self.blocks
+            .iter()
+            .find(|b| b.cue == cue)
+            .unwrap_or_else(|| panic!("narration/timeline.json has no cue '{cue}'"))
+    }
+    /// `after` seconds past the end of a cue's spoken line.
+    fn end_plus(&self, cue: &str, after: f64) -> u64 {
+        seconds(2.0 + self.block(cue).end + after)
+    }
+    fn at(&self, cue: &str) -> u64 {
+        seconds(2.0 + self.block(cue).start)
+    }
+    /// A point `f` of the way through a cue's spoken line (0 its start, 1 its end).
+    fn part(&self, cue: &str, f: f64) -> u64 {
+        let b = self.block(cue);
+        seconds(2.0 + b.start + (b.end - b.start) * f)
+    }
+}
+
+/// World origin of each region; the camera offset that frames it is the same.
+const A: [f32; 2] = [0.0, 0.0];
+const B: [f32; 2] = [1920.0, 0.0];
+const C: [f32; 2] = [1920.0, 1080.0];
+const D: [f32; 2] = [0.0, 1080.0];
+
+const DOORS: [(f32, &str, &str, &str); 4] = [
+    (300.0, "INFLATION", "", "THE ONLY EXIT"),
+    (
+        740.0,
+        "AI PRODUCTIVITY",
+        "MIRACLE",
+        "must shrink debt AND cost no jobs",
+    ),
+    (1180.0, "DEMOGRAPHIC", "SHOCK", "not a plan"),
+    (1620.0, "RIVALS", "FUND US", "not a plan"),
+];
+const DOOR_Y: f32 = 410.0;
+/// The doom loop, clockwise from the top: (card, x, y, title, width, and the
+/// three points of the arc that leaves it for the next card).
+type Hop = [[f32; 2]; 3];
+const RING: [(&str, f32, f32, &str, f32, Hop); 4] = [
+    (
+        "sell",
+        1220.0,
+        270.0,
+        "FOREIGNERS SELL TREASURIES",
+        430.0,
+        [[1445.0, 270.0], [1535.0, 360.0], [1560.0, 505.0]],
+    ),
+    (
+        "yields",
+        1560.0,
+        560.0,
+        "YIELDS UP",
+        240.0,
+        [[1560.0, 615.0], [1500.0, 770.0], [1355.0, 850.0]],
+    ),
+    (
+        "deficit",
+        1220.0,
+        850.0,
+        "DEFICIT UP",
+        250.0,
+        [[1085.0, 850.0], [940.0, 770.0], [880.0, 615.0]],
+    ),
+    (
+        "issuance",
+        880.0,
+        560.0,
+        "MORE ISSUANCE",
+        280.0,
+        [[880.0, 505.0], [930.0, 385.0], [1050.0, 325.0]],
+    ),
+];
+const HARD: [(&str, f32, f32, &str, f32); 3] = [
+    ("gold", 900.0, 740.0, "GOLD", 34.0),
+    ("silver", 1220.0, 800.0, "SILVER", 30.0),
+    ("bitcoin", 1540.0, 880.0, "a little BITCOIN", 24.0),
+];
+
+fn card(
+    o: [f32; 2],
+    id: &str,
+    x: f32,
+    y: f32,
+    title: &str,
+    detail: &str,
+    tone: &str,
+    width: f32,
+) -> Value {
+    let status = if detail.is_empty() {
+        json!([])
+    } else {
+        json!([{"text":detail,"tone":"muted"}])
+    };
+    json!({"kind":"card","id":id,"at":[o[0]+x,o[1]+y,0],"size":[width,90],"title":title,
+           "tone":tone,"status":status})
+}
+fn label(o: [f32; 2], id: &str, x: f32, y: f32, text: &str, size: f32, tone: &str) -> Value {
+    json!({"kind":"label","id":id,"at":[o[0]+x,o[1]+y,-1],"size":size,"spans":[{"text":text,"tone":tone}]})
+}
+fn label_left(o: [f32; 2], id: &str, x: f32, y: f32, text: &str, size: f32, tone: &str) -> Value {
+    json!({"kind":"label","id":id,"at":[o[0]+x,o[1]+y,-1],"size":size,"align":"left",
+           "spans":[{"text":text,"tone":tone}]})
+}
+/// A filled rectangle; `stroke` is a tone or null.
+fn rect(
+    o: [f32; 2],
+    id: &str,
+    at: [f32; 2],
+    size: [f32; 2],
+    fill: &str,
+    fill_opacity: f32,
+    stroke: Value,
+) -> Value {
+    json!({"kind":"shape","id":id,"at":[o[0]+at[0],o[1]+at[1],0],"shape":{"rect":size},"corner":6,
+           "fill":fill,"fillOpacity":fill_opacity,"stroke":stroke,"width":3})
+}
+fn line(
+    o: [f32; 2],
+    id: &str,
+    from: [f32; 2],
+    to: [f32; 2],
+    tone: &str,
+    width: f32,
+    arrow: &str,
+) -> Value {
+    json!({"kind":"path","id":id,"through":[[o[0]+from[0],o[1]+from[1],-1],[o[0]+to[0],o[1]+to[1],-1]],
+           "tone":tone,"width":width,"arrow":arrow})
+}
+fn wire(id: &str, from: &str, to: &str, tone: &str) -> [Value; 2] {
+    [
+        json!({"kind":"path","id":id,"through":[from,to],"arrow":"end","tone":tone}),
+        json!({"kind":"packet","id":format!("p-{id}"),"beam":id,"tone":tone}),
+    ]
+}
+
+/// Region A: what is owed every year against what comes in, and 2020-22.
+fn yardstick(e: &mut Vec<Value>) {
+    e.extend([
+        label(
+            A,
+            "question",
+            960.0,
+            440.0,
+            "Can the US inflate its debt away?",
+            46.0,
+            "plain",
+        ),
+        label(A, "yes", 960.0, 600.0, "YES", 130.0, "accent"),
+        // 100% of receipts is 440 px; both bars stand on y = 900.
+        rect(
+            A,
+            "receipts",
+            [380.0, 680.0],
+            [220.0, 440.0],
+            "success",
+            0.3,
+            json!("success"),
+        ),
+        label(
+            A,
+            "receipts-name",
+            380.0,
+            935.0,
+            "TAX RECEIPTS",
+            22.0,
+            "success",
+        ),
+        rect(
+            A,
+            "interest",
+            [700.0, 855.0],
+            [240.0, 90.0],
+            "error",
+            0.35,
+            json!("error"),
+        ),
+        label(A, "interest-name", 700.0, 855.0, "INTEREST", 20.0, "plain"),
+        rect(
+            A,
+            "entitlements",
+            [700.0, 690.0],
+            [240.0, 240.0],
+            "warning",
+            0.35,
+            json!("warning"),
+        ),
+        label(
+            A,
+            "entitlements-name",
+            700.0,
+            690.0,
+            "ENTITLEMENTS",
