+fn diagram() -> Result<StagePlan> {
+    let mut elements = Vec::new();
+    yardstick(&mut elements);
+    exits(&mut elements);
+    japan(&mut elements);
+    doom_loop(&mut elements);
+    let mut plan: StagePlan = serde_json::from_value(json!({"elements":elements}))?;
+    plan.post = StagePost::RESTRAINED;
+    Ok(plan)
+}
+fn text(
+    scene: &mut PlanBuilder,
+    id: &str,
+    value: &str,
+    y: f32,
+    size: f32,
+    tone: Tone,
+) -> Result<Caption> {
+    Caption::declare(
+        scene,
+        id,
+        &CaptionPlan::line([80.0, y], size, vec![CaptionSpanPlan::new(value, tone)]),
+    )
+}
+fn launch(scene: &mut PlanBuilder, s: &Stage, at: u64, edge: &str, to: &str, travel: f32) {
+    scene.at(
+        at,
+        s.connect(edge, travel.min(0.3))
+            .then(s.send(format!("p-{edge}"), travel))
+            .with(sfx::SEND.beat(format!("s-{edge}-{at}"), -22.0))
+            .then(s.land(to)),
+    );
+}
+/// Pan to a region. The move starts on the cue, so the region is framed before
+/// its first element appears.
+fn frame(scene: &mut PlanBuilder, s: &Stage, at: u64, region: [f32; 2]) {
+    scene.at(
+        at,
+        s.to("camera.x", region[0], 1.0)
+            .also(s.to("camera.y", region[1], 1.0))
+            .with(sfx::WHOOSH.beat(format!("pan-{at}"), -24.0)),
+    );
+}
+fn show(scene: &mut PlanBuilder, s: &Stage, at: u64, ids: &[&str]) {
+    for id in ids {
+        scene.at(at, s.fade_in(*id, 1.0, 0.45));
+    }
+}
+fn hide(scene: &mut PlanBuilder, s: &Stage, at: u64, ids: &[&str]) {
+    for id in ids {
+        scene.at(at, s.to(format!("{id}.opacity"), 0.0, 0.4));
+    }
+}
+fn door_parts(n: usize) -> Vec<String> {
+    ["", "-num", "-a", "-b", "-knob"]
+        .into_iter()
+        .filter(|part| *part != "-b" || !DOORS[n - 1].2.is_empty())
+        .map(|part| format!("door{n}{part}"))
+        .collect()
+}
+/// Light a door while it is being considered.
+fn consider(scene: &mut PlanBuilder, s: &Stage, at: u64, n: usize) {
+    scene.at(
+        at,
+        s.fade_in(format!("door{n}-lit"), 1.0, 0.35)
+            .also(s.glide(format!("door{n}.scale"), 1.05, 0.5))
+            .also(s.glide(format!("door{n}-lit.scale"), 1.05, 0.5))
+            .with(sfx::TICK.beat(format!("consider-{n}"), -18.0)),
+    );
+}
+/// Cross a door out and leave it dim for the rest of the film.
+fn reject(scene: &mut PlanBuilder, s: &Stage, at: u64, n: usize) {
+    scene.at(
+        at,
+        s.to(format!("door{n}-x1.draw"), 1.0, 0.25)
+            .also(
+                s.to(format!("door{n}-x2.draw"), 1.0, 0.25)
+                    .after(seconds(0.12)),
+            )
+            .also(s.to(format!("door{n}-lit.opacity"), 0.0, 0.4))
+            .also(s.glide(format!("door{n}.scale"), 1.0, 0.5))
+            .with(sfx::SEVER.beat(format!("reject-{n}"), -18.0)),
+    );
+    for id in door_parts(n) {
+        scene.at(at + seconds(0.3), s.to(format!("{id}.opacity"), 0.3, 0.6));
+    }
+    for part in ["x1", "x2"] {
+        scene.at(
+            at + seconds(0.9),
+            s.to(format!("door{n}-{part}.opacity"), 0.6, 0.6),
+        );
+    }
+}
+
+fn build(c: &Clip) -> Result<ScenePlan> {
+    let plan = diagram()?;
+    let mut scene = PlanBuilder::new("gromen-inflate", seconds(c.duration + 5.0));
+    scene.media(MediaPlan {
+        id: "voice".into(),
+        path: "narration/continuous.m4a".into(),
+        kind: MediaKindPlan::Audio,
+        role: MediaRolePlan::Script,
+        source_start_nanos: 0,
+        source_end_nanos: seconds(c.duration),
+        timeline_start_nanos: seconds(2.0),
+        timeline_end_nanos: seconds(c.duration + 2.0),
+        gain_db: 0.0,
+    });
+    let s = Stage::declare(&mut scene, "stage", &plan)?;
+    let header = text(
+        &mut scene,
+        "title",
+        "THE ONLY EXIT / INFLATING THE DEBT AWAY",
+        66.0,
+        34.0,
+        Tone::Plain,
+    )?;
+    // On screen for the whole film: the narrator is not Gromen.
+    let credit = text(
+        &mut scene,
+        "credit",
+        "AI-NARRATED SUMMARY · source: Luke Gromen, FFTT, Oct 7 2026",
+        112.0,
+        19.0,
+        Tone::Warning,
+    )?;
+    scene.at(seconds(0.1), header.type_in(110.0, 0.0));
+    scene.at(seconds(0.3), credit.show());
+
+    // Everything starts hidden and is revealed by the cue that introduces it.
+    for el in &plan.elements {
+        let id = el.id();
+        match el {
+            StageElement::Path { .. } => scene.at(0, s.channel(format!("{id}.draw"), 0.0)),
+            StageElement::Packet { .. } => continue,
+            _ => scene.at(0, s.channel(format!("{id}.opacity"), 0.0)),
+        };
+    }
+    scene.at(
+        0,
+        s.channel("camera.x", 0.0).also(s.channel("camera.y", 0.0)),
+    );
+
+    // The lower-left beat labels are the narration's own captions, so they
+    // cannot drift from the script. A line too long for the frame is listed here.
+    let shortened = [(
+        "ai",
+        "Exit two: an AI productivity miracle. Shrink the debt, without costing a single job. Good luck.",
+    )];
+    for (i, block) in c.blocks.iter().enumerate() {
+        let value = shortened
+            .iter()
+            .find(|(cue, _)| *cue == block.cue)
+            .map_or(block.text.as_str(), |(_, short)| short);
+        let cap = text(
+            &mut scene,
+            &format!("note-{i}"),
+            value,
+            1020.0,
+            24.0,
+            Tone::Plain,
+        )?;
+        scene.at(c.at(&block.cue), cap.show());
+        if let Some(next) = c.blocks.get(i + 1) {
+            scene.at(c.at(&next.cue) - seconds(0.16), cap.hide());
+        }
+    }
+
+    // intro: the question, and the answer on its last word.
+    show(&mut scene, &s, c.at("intro") + seconds(0.2), &["question"]);
+    scene.at(
+        c.part("intro", 0.86),
+        s.fade_in("yes", 1.0, 0.3)
+            .also(s.land("yes"))
+            .with(sfx::CONFIRM.beat("yes", -14.0)),
+    );
+
+    // measure: the question becomes the heading and the yardstick is built under it.
+    let at = c.at("measure");
+    scene.at(
+        at,
+        s.glide("question.y", -255.0, 0.9)
+            .also(s.glide("question.scale", 0.6, 0.9))
+            .also(s.glide("yes.y", -365.0, 0.9))
+            .also(s.glide("yes.scale", 0.3, 0.9)),
+    );
+    show(&mut scene, &s, at + seconds(0.5), &["stack-name"]);
+    for (id, f) in [
+        ("interest", 0.2),
+        ("entitlements", 0.38),
+        ("veterans", 0.56),
+    ] {
+        let name = format!("{id}-name");
+        show(&mut scene, &s, c.part("measure", f), &[id, &name]);
+        scene.at(
+            c.part("measure", f),
+            sfx::TICK.beat(format!("block-{id}"), -18.0),
+        );
+    }
+    show(
+        &mut scene,
+        &s,
+        c.part("measure", 0.8),
+        &["receipts", "receipts-name", "full-name"],
+    );
+    scene.at(c.part("measure", 0.8), s.to("full.draw", 1.0, 0.6));
+
+    // covid: the stack passes 100% of receipts and the Fed prints the difference.
+    show(
+        &mut scene,
+        &s,
+        c.part("covid", 0.2),
+        &["surge", "surge-name"],
+    );
+    show(
+        &mut scene,
+        &s,
+        c.part("covid", 0.42),
+        &["pct-110", "pct-110-year"],
+    );
+    scene.at(
+        c.part("covid", 0.2),
+        s.land("surge").with(sfx::IMPACT.beat("surge", -20.0)),
+    );
+    show(&mut scene, &s, c.part("covid", 0.68), &["fed", "fed-name"]);
+    launch(
+        &mut scene,
+        &s,
+        c.part("covid", 0.68) + seconds(0.4),
+        "fed-fill",
+        "surge",
+        0.6,
+    );
+
+    // proof: zero rates and ~10% inflation, and the ratio counts down.
+    show(
+        &mut scene,
+        &s,
+        c.at("proof") + seconds(0.1),
+        &["rates-name", "rates"],
+    );
+    show(
+        &mut scene,
+        &s,
+        c.part("proof", 0.14),
+        &["inflation-name", "inflation"],
+    );
+    show(
+        &mut scene,
+        &s,
+        c.part("proof", 0.36),
+        &["ratio-name", "ratio-130"],
+    );
+    let (from, to) = (c.part("proof", 0.58), c.part("proof", 0.82));
+    for (i, pct) in (115..130).rev().enumerate() {
+        let at = from + (to - from) * (i as u64 + 1) / 15;
+        scene.at(
+            at,
+            s.set(format!("ratio-{}.opacity", pct + 1), 0.0)
+                .also(s.set(format!("ratio-{pct}.opacity"), 1.0)),
+        );
+    }
+    scene.at(
+        to,
+        s.land("ratio-115").with(sfx::CONFIRM.beat("ratio", -16.0)),
+    );
+    show(&mut scene, &s, c.part("proof", 0.84), &["months"]);
+    // The burden falls back under receipts.
+    hide(
+        &mut scene,
+        &s,
+        c.end_plus("proof", 0.2),
+        &["surge", "surge-name", "pct-110", "pct-110-year"],
+    );
+    scene.at(c.end_plus("proof", 0.2), s.to("fed-fill.draw", 0.0, 0.4));
+    show(&mut scene, &s, c.end_plus("proof", 0.6), &["pct-85"]);
+
+    // ai: the four exits; number two is considered and crossed out.
+    let at = c.at("ai");
+    frame(&mut scene, &s, at, B);
+    show(&mut scene, &s, at + seconds(0.5), &["exits-name"]);
+    for n in 1..=4 {
+        for id in door_parts(n) {
+            scene.at(
+                at + seconds(0.5 + n as f64 * 0.12),
+                s.fade_in(id, 1.0, 0.45),
+            );
+        }
+    }
+    consider(&mut scene, &s, at + seconds(1.3), 2);
+    show(&mut scene, &s, c.part("ai", 0.42), &["door2-note"]);
+    reject(&mut scene, &s, c.part("ai", 0.88), 2);
+
+    // others: three and four, then both crossed out on "neither is a plan".
+    consider(&mut scene, &s, c.part("others", 0.2), 3);
+    consider(&mut scene, &s, c.part("others", 0.45), 4);
+    for n in [3, 4] {
+        let at = c.part("others", 0.8) + seconds((n - 3) as f64 * 0.25);
+        reject(&mut scene, &s, at, n);
+        scene.at(at, s.fade_in(format!("door{n}-note"), 1.0, 0.45));
+    }
+
+    // japan: the comparison, column by column.
+    let at = c.at("japan");
+    frame(&mut scene, &s, at, C);
+    show(
+        &mut scene,
+        &s,
+        at + seconds(0.6),
+        &["jp-flag", "jp-dot", "jp-name"],
+    );
+    show(&mut scene, &s, c.part("japan", 0.22), &["jp-1"]);
+    show(&mut scene, &s, c.part("japan", 0.4), &["jp-2", "jp-3"]);
+    let usa = c.part("japan", 0.56);
+    let flag = [
+        "us-flag",
+        "us-stripe0",
+        "us-stripe1",
+        "us-stripe2",
+        "us-stripe3",
+        "us-canton",
+    ];
+    show(&mut scene, &s, usa, &flag);
+    show(&mut scene, &s, usa, &["us-name", "versus"]);
+    for (i, id) in ["us-1", "us-2", "us-3"].into_iter().enumerate() {
+        show(&mut scene, &s, usa + seconds(0.2 + i as f64 * 0.2), &[id]);
+    }
+    scene.at(
+        c.part("japan", 0.8),
+        s.fade_in("us-4", 1.0, 0.4)
+            .also(s.land("us-4"))
+            .with(sfx::IMPACT.beat("press", -18.0)),
+    );
+
+    // dollar: the strong-dollar option is offered and rejected.
+    let at = c.at("dollar");
+    frame(&mut scene, &s, at, D);
+    show(&mut scene, &s, at + seconds(0.6), &["strong"]);
+    for (id, ..) in RING {
+        scene.at(at + seconds(1.0), s.fade_in(id, 0.3, 0.6));
+    }
+    let no = c.part("dollar", 0.55);
+    scene.at(
+        no,
+        s.to("strong-x1.draw", 1.0, 0.25)
+            .also(s.to("strong-x2.draw", 1.0, 0.25).after(seconds(0.12)))
+            .also(s.hit("strong.damage", 1.0, 0.5))
+            .also(s.jolt([0.6, -0.4], 0.7))
+            .with(sfx::SEVER.beat("reject-strong", -14.0)),
+    );
+    show(&mut scene, &s, no + seconds(0.3), &["strong-note"]);
+
+    // loop: named once around on the words, then faster and faster until `gold`.
+    let at = c.at("loop");
+    scene.at(at, s.to("strong.opacity", 0.6, 0.6));
+    show(&mut scene, &s, at, &["core", "core-name"]);
+    launch(&mut scene, &s, at, "strong-feed", "sell", 0.5);
+    for (i, f) in [0.0, 0.28, 0.46, 0.62].into_iter().enumerate() {
+        let (id, next) = (RING[i].0, RING[(i + 1) % 4].0);
+        let named = c.part("loop", f) + seconds(0.25);
+        scene.at(
+            named,
+            s.to(format!("{id}.opacity"), 1.0, 0.3).also(s.land(id)),
+        );
+        launch(
+            &mut scene,
+            &s,
+            named + seconds(0.3),
+            &format!("loop-{id}"),
+            next,
+            0.5,
+        );
+    }
+    let (mut lap, mut length) = (c.part("loop", 0.78), 1.6_f64);
+    let stop = c.at("gold") - seconds(0.3);
+    while lap + seconds(length) < stop {
+        for (i, (id, ..)) in RING.into_iter().enumerate() {
+            let step = length / 4.0;
+            launch(
+                &mut scene,
+                &s,
+                lap + seconds(step * i as f64),
+                &format!("loop-{id}"),
+                RING[(i + 1) % 4].0,
+                step as f32 * 0.9,
+            );
+        }
+        lap += seconds(length);
+        length = (length * 0.72).max(0.6);
+    }
+    let spin = (stop - at) as f32 / 1e9;
+    scene.at(
+        at,
+        s.charge("core", 1.0, spin)
+            .also(s.to("camera.zoom", 1.07, spin)),
+    );
+
+    // gold: back to the exits. Door one is the only one lit; hard assets rise.
+    let at = c.at("gold");
+    frame(&mut scene, &s, at, B);
+    scene.at(at, s.to("camera.zoom", 1.0, 0.8));
+    scene.at(
+        at + seconds(0.9),
+        s.fade_in("door1-lit", 1.0, 0.4)
+            .also(s.glide("door1.scale", 1.06, 0.6))
+            .also(s.glide("door1-lit.scale", 1.06, 0.6))
+            .also(s.land("door1"))
+            .with(sfx::BLOOM.beat("only-exit", -15.0)),
+    );
+    show(&mut scene, &s, c.part("gold", 0.22), &["door1-note"]);
+    show(&mut scene, &s, c.part("gold", 0.4), &["short"]);
+    scene.at(
+        c.part("gold", 0.5),
+        s.to("short-strike.draw", 1.0, 0.3)
+            .with(sfx::SEVER.beat("no-short", -18.0)),
+    );
+    for ((id, ..), f) in HARD.into_iter().zip([0.66, 0.78, 0.9]) {
+        let at = c.part("gold", f);
+        scene.at(
+            at,
+            s.to(format!("{id}-up.draw"), 1.0, 0.7)
+                .also(s.to(format!("{id}-up.emphasis"), 1.0, 0.7))
+                .also(
+                    s.fade_in(format!("{id}-name"), 1.0, 0.4)
+                        .after(seconds(0.2)),
+                )
+                .with(sfx::CONFIRM.beat(format!("rise-{id}"), -15.0)),
+        );
+    }
+    Ok(scene.finish()?)
+}
+fn main() -> Result<()> {
+    run(PathBuf::from(env!("CARGO_MANIFEST_DIR")))
+}
+/// Build the plan and captions for the scene directory holding `narration/timeline.json`.
+fn run(here: PathBuf) -> Result<()> {
+    // TIMELINE points the choreography at another timeline, to check it
+    // against timings other than the recorded narration's.
+    let timeline = std::env::var_os("TIMELINE")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| here.join("narration/timeline.json"));
+    let clips: Vec<Clip> = serde_json::from_slice(&std::fs::read(timeline)?)?;
+    let c = &clips[0];
+    build(c)?.write_or_print(Some(here.join("continuous.json")))?;
+    let stamp = |t: f64| {
+        let ms = (t * 1000.0).round() as u64;
+        format!(
+            "{:02}:{:02}:{:02}.{:03}",
+            ms / 3600000,
+            ms / 60000 % 60,
+            ms / 1000 % 60,
+            ms % 1000
+        )
+    };
+    let vtt = "WEBVTT\n\n".to_string()
+        + &c.blocks
+            .iter()
+            .map(|b| {
+                format!(
+                    "{} --> {}\n{}\n\n",
+                    stamp(2.0 + b.start),
+                    stamp(2.0 + b.end),
+                    b.text
+                )
+            })
+            .collect::<String>();
+    std::fs::write(here.join("captions.vtt"), vtt)?;
+    println!("ONE CONTINUOUS SCENE / {:.1}s", c.duration + 5.0);
+    Ok(())
+}
