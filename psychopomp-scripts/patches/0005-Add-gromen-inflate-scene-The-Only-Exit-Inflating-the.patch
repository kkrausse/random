@@ -0,0 +1,103 @@
+#!/usr/bin/env bash
+# One command for the whole film: narration -> plan -> render -> public page.
+#
+#   build.sh [--voice] [--stills] [--publish [--private | --public | --tunnel]]
+#
+#   --voice    regenerate narration/ from narration/script.json (needs tts-lab + GPU)
+#   --stills   write one PNG per cue to output/gromen-inflate-stills/ and stop
+#              (seconds, instead of the multi-minute full render)
+#   --publish  after packaging, copy the page to
+#              $REPORTS_DIR/gromen-inflate-YYYYMMDD and deploy it
+#   --private  with --publish: deploy privately (the default)
+#   --public   with --publish: deploy on the public site
+#   --tunnel   with --publish: deploy through the tunnel
+#              (the chosen one is passed to the deploy script as its first argument)
+#
+# Environment:
+#   CARGO             cargo command                (default: cargo +1.95.0)
+#   CARGO_TARGET_DIR  share a build cache between worktrees
+#   TTS_LAB_DIR       tts-lab checkout             (default: $HOME/devfs/repos/kkrausse/random/tts-lab)
+#   REPORTS_DIR       where --publish copies to    (default: $HOME/devfs/repos/kkrausse/reports)
+#   DEPLOY            deploy script                (default: $HOME/devfs/repos/kkrausse/random/scripts/deploy-artifact.sh)
+#   TIMELINE          use another timeline.json for the plan and stills
+set -euo pipefail
+
+HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+ROOT="$(cd -- "$HERE/../.." && pwd)"
+NAME=gromen-inflate
+CARGO="${CARGO:-cargo +1.95.0}"
+TTS_LAB_DIR="${TTS_LAB_DIR:-$HOME/devfs/repos/kkrausse/random/tts-lab}"
+REPORTS_DIR="${REPORTS_DIR:-$HOME/devfs/repos/kkrausse/reports}"
+DEPLOY="${DEPLOY:-$HOME/devfs/repos/kkrausse/random/scripts/deploy-artifact.sh}"
+PLAN="$HERE/continuous.json"
+OUT="$ROOT/output"
+
+voice=0 stills=0 publish=0 destination=--private
+for arg in "$@"; do
+  case "$arg" in
+    --voice) voice=1 ;;
+    --stills) stills=1 ;;
+    --publish) publish=1 ;;
+    --private | --public | --tunnel) destination="$arg" ;;
+    -h | --help) sed -n '2,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
+    *) echo "build.sh: unknown option $arg (see --help)" >&2; exit 2 ;;
+  esac
+done
+step() { printf '\n==> %s\n' "$*"; }
+
+cd "$ROOT"
+
+if ((voice)); then
+  step "narration: voice.py (TTS_LAB_DIR=$TTS_LAB_DIR)"
+  python="$TTS_LAB_DIR/orpheus/.venv/bin/python"
+  [[ -x "$python" ]] || { echo "no Orpheus python at $python; set TTS_LAB_DIR" >&2; exit 1; }
+  TTS_LAB_DIR="$TTS_LAB_DIR" "$python" "$HERE/voice.py"
+else
+  step "narration: kept as is (pass --voice to regenerate)"
+fi
+
+step "plan: $PLAN"
+$CARGO run -q -p "psychopomp-$NAME"
+
+step "renderer: release build"
+$CARGO build -q --release -p psychopomp-render
+BIN="${CARGO_TARGET_DIR:-$ROOT/target}/release/psychopomp"
+"$BIN" plan validate "$PLAN"
+
+if ((stills)); then
+  dir="$OUT/$NAME-stills"
+  step "stills: one per cue -> $dir"
+  rm -rf "$dir"
+  mkdir -p "$dir"
+  # The narration starts 2 s into the film; sample 1.5 s into each block, and
+  # once more at the last frame to see what the film ends on.
+  python3 - "${TIMELINE:-$HERE/narration/timeline.json}" <<'PY' |
+import json, sys
+clip = json.load(open(sys.argv[1]))[0]
+for i, block in enumerate(clip["blocks"]):
+    print(f"{i:02d}-{block['cue']} {2.0 + block['start'] + 1.5:.2f}")
+print(f"{len(clip['blocks']):02d}-end {clip['duration'] + 4.9:.2f}")
+PY
+  while read -r name at; do
+    "$BIN" plan frame "$PLAN" "$at" "$dir/$name.png" --theme neutral >/dev/null
+    echo "  $name.png  @ ${at}s"
+  done
+  step "done (stills only; no render, no package)"
+  exit 0
+fi
+
+mkdir -p "$OUT"
+step "render: $OUT/$NAME-raw.mp4 (several minutes)"
+"$BIN" plan render "$PLAN" "$OUT/$NAME-raw.mp4" --theme neutral
+
+step "package: $OUT/$NAME-public/"
+python3 "$HERE/package.py"
+
+if ((publish)); then
+  dest="$REPORTS_DIR/$NAME-$(date +%Y%m%d)"
+  step "publish ($destination): $dest"
+  mkdir -p "$dest"
+  cp -a "$OUT/$NAME-public/." "$dest/"
+  "$DEPLOY" "$destination" "$dest"
+fi
+step "done"
