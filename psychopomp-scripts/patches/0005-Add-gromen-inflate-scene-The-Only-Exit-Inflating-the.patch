+"""Package "The Only Exit" as a public page: video, captions, poster, script and source.zip."""
+import html
+import json
+import pathlib
+import shutil
+import subprocess
+import zipfile
+
+HERE = pathlib.Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+OUT = ROOT / "output/gromen-inflate-public"
+SOURCE = "https://www.youtube.com/watch?v=INgvg03agP8"
+OUT.mkdir(parents=True, exist_ok=True)
+revision = subprocess.run(["git", "-C", str(ROOT), "merge-base", "HEAD", "origin/main"], capture_output=True,
+                          text=True).stdout.strip()[:7] or "main"  # upstream commit the scene builds against
+script = json.loads((HERE / "narration/script.json").read_text())
+clip = json.loads((HERE / "narration/timeline.json").read_text())[0]
+raw = ROOT / "output/gromen-inflate-raw.mp4"
+# No loudnorm here: the narration is mixed to get louder toward the end, and
+# dynamic normalization would level that back out.
+subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", str(raw), "-c:v", "copy", "-ar", "48000",
+                "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart", str(OUT / "only-exit.mp4")],
+               check=True)
+# Poster: the end of the finale, door 1 lit and the hard assets up (the narration starts 2 s in).
+finale = next(b for b in clip["blocks"] if b["cue"] == "gold")
+subprocess.run(["ffmpeg", "-y", "-v", "error", "-ss", f"{finale['end'] + 2 + 1.0:.2f}", "-i", str(raw),
+                "-frames:v", "1", str(OUT / "poster.png")], check=True)
+shutil.copy2(HERE / "captions.vtt", OUT / "captions.vtt")
+shutil.copy2(HERE / "narration/script.json", OUT / "script.json")
+blocks = script["clips"][0]["blocks"]
+text = " ".join(block["text"] for block in blocks)
+spoken = " ".join(block["say"] for block in blocks)
+page = """<!doctype html><html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1"><link rel="icon" href="data:,">
+<title>The Only Exit / Inflating the debt away</title>
+<style>:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#090d14;color:#edf1fa}*{box-sizing:border-box}body{margin:0}main{max-width:1200px;margin:auto;padding:32px 24px 70px}a{color:#afd6ff;text-underline-offset:4px}nav{display:flex;gap:24px;font-size:14px;margin-bottom:38px;flex-wrap:wrap}.tag{color:#efbe77;font:12px monospace;letter-spacing:.15em}h1{font-size:clamp(40px,7vw,76px);letter-spacing:-.05em;line-height:1.05;margin:14px 0}.sub{color:#b5c3d7;font-size:18px;line-height:1.6;margin-bottom:10px}.disclosure{color:#efbe77;font-size:15px;margin:0 0 28px}video{display:block;width:100%;border:1px solid #364252;border-radius:12px;background:#03070c}.links{display:flex;gap:12px;flex-wrap:wrap;margin:22px 0 30px}.links a{padding:10px 15px;border:1px solid #364252;background:#152031;border-radius:8px;text-decoration:none}details{margin-top:20px;border-top:1px solid #364252;padding:18px 0}summary{cursor:pointer;font-size:17px}p,li{line-height:1.7;color:#bcc8da}footer{color:#8999ae;font:12px monospace;margin-top:35px}@media(max-width:600px){main{padding:22px 14px}nav{margin-bottom:30px}.sub{font-size:16px}.links a{font-size:13px}}</style>
+</head><body><main><nav><a href="/artifacts/">All artifacts</a><a href="__SOURCE__">Original video</a></nav>
+<div class="tag">ONE DIAGRAM · NO CUTS · AI-NARRATED SUMMARY</div><h1>The Only Exit.<br>Inflating the debt away.</h1>
+<p class="sub">An AI-voiced summary, in our own words, of Luke Gromen's FFTT video <a href="__SOURCE__">"Does the Administration believe they can inflate US debt to sustainability?"</a> (recorded Oct 7 2026).</p>
+<p class="disclosure">The narrator is a synthetic voice, not Luke Gromen. This is not a recording of him and it is not endorsed by him. Watch the original for his argument in his words.</p>
+<video controls playsinline preload="metadata" poster="poster.png"><source src="only-exit.mp4" type="video/mp4"><track src="captions.vtt" kind="captions" srclang="en" label="English"></video>
+<div class="links"><a href="only-exit.mp4" download>Download MP4</a><a href="source.zip" download>Animation source</a></div>
+<details><summary>Script</summary><p>__TEXT__</p><p><a href="script.json">Script JSON</a> · <a href="captions.vtt">Captions</a></p></details>
+<details><summary>How it was made</summary><p>One Psychopomp Scene Plan: a single diagram whose choreography follows the narration's timings. The voice is Orpheus 3B (voice "dan"), an open speech model run locally. It has no emotion or volume setting, so the build comes from how the lines are written for it:</p><p><em>__SPOKEN__</em></p><p>Each line's start and end were found by transcribing the audio, and the animation and captions follow those times. <code>source.zip</code> holds the scene, the narration and a script that rebuilds the film.</p><p>1920×1080 at 60 fps, temporal motion blur. Built with <a href="https://github.com/kitlangton/psychopomp">Psychopomp</a>.</p></details>
+<footer>AI-NARRATED SUMMARY · SOURCE: LUKE GROMEN, FFTT, OCT 7 2026 · AI VOICE, NOT LUKE GROMEN</footer>
+</main></body></html>"""
+(OUT / "index.html").write_text(page.replace("__SOURCE__", SOURCE).replace("__TEXT__", html.escape(text))
+                                .replace("__SPOKEN__", html.escape(spoken)))
+reproduce = f"""#!/usr/bin/env bash
+# Rebuilds the film from the bundled narration audio; no speech model needed.
+set -euo pipefail
+HERE="$(cd -- "$(dirname -- "${{BASH_SOURCE[0]}}")" && pwd)"
+DEST="${{1:-$HERE/psychopomp-build}}"
+git clone https://github.com/kitlangton/psychopomp.git "$DEST"
+git -C "$DEST" checkout --detach {revision}
+mkdir -p "$DEST/scenes/gromen-inflate"
+cp -a "$HERE/scene/." "$DEST/scenes/gromen-inflate/"
+cd "$DEST"
+cargo run -p psychopomp-gromen-inflate
+mkdir -p output
+cargo run --release -- plan render scenes/gromen-inflate/continuous.json output/raw.mp4 --theme neutral
+ffmpeg -y -i output/raw.mp4 -c:v copy -ar 48000 -c:a aac -b:a 192k -movflags +faststart output/only-exit.mp4
+"""
+(OUT / "reproduce.sh").write_text(reproduce)
+with zipfile.ZipFile(OUT / "source.zip", "w", zipfile.ZIP_DEFLATED) as bundle:
+    bundle.writestr("reproduce.sh", reproduce)
+    bundle.write(ROOT / "LICENSE", "LICENSE")
+    for name in ["Cargo.toml", "src/main.rs", "voice.py", "package.py", "README.md",
+                 "narration/script.json", "narration/timeline.json", "narration/continuous.m4a"]:
+        bundle.write(HERE / name, "scene/" + name)
+print(f"{OUT}: {clip['duration']+5:.1f}s, 1 scene")
