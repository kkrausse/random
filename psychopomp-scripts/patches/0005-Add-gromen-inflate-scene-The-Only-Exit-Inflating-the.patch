+/// Region D: the strong-dollar option, and the loop it sets off.
+fn doom_loop(e: &mut Vec<Value>) {
+    e.extend([
+        card(D, "strong", 400.0, 330.0, "STRONG DOLLAR?", "the other way to hold the debt", "request", 440.0),
+        line(D, "strong-x1", [190.0, 290.0], [610.0, 370.0], "error", 7.0, "none"),
+        line(D, "strong-x2", [610.0, 290.0], [190.0, 370.0], "error", 7.0, "none"),
+        label(D, "strong-note", 400.0, 425.0, "\"root canal with a shotgun\"", 22.0, "error"),
+        json!({"kind":"orb","id":"core","at":[D[0]+1220.0,D[1]+560.0,0],"radius":78,"points":450,"tone":"error"}),
+        label(D, "core-name", 1220.0, 560.0, "DOOM LOOP", 24.0, "plain"),
+    ]);
+    for (id, x, y, title, width, hop) in RING {
+        e.push(card(D, id, x, y, title, "", "error", width));
+        // Hops are drawn through points: a card-to-card path would cut across the orb.
+        let through = hop.map(|[x, y]| [D[0] + x, D[1] + y, -1.0]);
+        e.push(
+            json!({"kind":"path","id":format!("loop-{id}"),"through":through,"curve":"smooth",
+                      "arrow":"end","tone":"error","width":3}),
+        );
+        e.push(json!({"kind":"packet","id":format!("p-loop-{id}"),"beam":format!("loop-{id}"),"tone":"error"}));
+    }
+    e.extend(wire("strong-feed", "strong", "sell", "request"));
+}
