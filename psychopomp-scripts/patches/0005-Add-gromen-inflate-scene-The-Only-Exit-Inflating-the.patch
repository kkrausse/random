@@ -0,0 +1,23 @@
+{
+  "title": "The Only Exit / Inflating the Debt Away",
+  "basis": "An AI-narrated summary, in our own words, of Luke Gromen's FFTT Q&A video \"Does the Administration believe they can inflate US debt to sustainability?\" (recorded October 7, 2026, https://www.youtube.com/watch?v=INgvg03agP8). It is not a recording of him, he did not narrate it, and it is not endorsed by him.",
+  "voice": "Orpheus 3B, voice dan, temperature 0.9, third-person narrator. `text` is the caption. `say` is what the model speaks for it. `lead` and `tail` are spoken around the block to push the delivery, then cut out. `takes` groups blocks into generations with their seeds.",
+  "clips": [{"id":"continuous","title":"THE ONLY EXIT / INFLATING THE DEBT AWAY","blocks":[
+    {"cue":"intro","text":"Does Washington think it can inflate the debt away? Luke Gromen's answer: yes.","say":"Does Washington think it can inflate the debt away? Luke Gromen's answer: yes.","gapAfter":1},
+    {"cue":"measure","text":"His yardstick: interest, entitlements and veterans' benefits, against tax receipts.","say":"His yardstick: interest, entitlements, and veterans' benefits, against tax receipts.","gapAfter":1.5},
+    {"cue":"covid","text":"In 2020 that hit about 110% of receipts. So the Fed printed the difference.","say":"In twenty twenty, that hit about a hundred and ten percent of receipts. So the Fed printed the difference.","gapAfter":1.5},
+    {"cue":"proof","text":"Zero rates, inflation near 10%. Debt to GDP fell from 130% to 115% in eighteen months.","say":"Zero rates, inflation near ten percent. Debt to G D P fell from a hundred and thirty percent to a hundred and fifteen, in eighteen months!","gapAfter":2},
+    {"cue":"ai","text":"Exit two: an AI productivity miracle. Big enough to shrink the debt, without costing a single job. Good luck.","say":"Exit two: an A I productivity miracle. Big enough to shrink the debt, without costing a single job. Good luck!","gapAfter":1.5},
+    {"cue":"others","text":"The other exits: a demographic shock, or rivals who suddenly bankroll America. Neither is a plan.","say":"The other exits: a demographic shock, or rivals who suddenly bankroll America. Neither is a plan!","gapAfter":2},
+    {"cue":"japan","text":"Why not Japan's way? Japan owes itself and has savings abroad. America's piggy bank is the printing press.","say":"Why not Japan's way? Japan owes itself, and has savings abroad. America's piggy bank is the PRINTING PRESS!","gapAfter":2},
+    {"cue":"dollar","text":"A stronger dollar instead? He calls that a root canal with a shotgun.","lead":"Oh, come ON! Are you SERIOUS?!","say":"A STRONGER dollar instead?! He calls that a root canal, with a SHOTGUN!!","tail":"That is INSANE!!","gapAfter":1.5},
+    {"cue":"loop","text":"Foreigners sell Treasuries. Yields up. Deficits up. More debt. Wash, rinse, repeat.","lead":"Ugh! And it gets WORSE! It gets SO much worse!!","say":"Foreigners SELL Treasuries! Yields UP! Deficits UP! More DEBT! Wash! Rinse! REPEAT!!","tail":"Are you KIDDING me?!","gapAfter":3},
+    {"cue":"gold","text":"So inflation is the only exit. His play is not shorting bonds. It's gold, silver, and a little bitcoin.","lead":"LISTEN to me!! LISTEN!!!","say":"So INFLATION! Is the ONLY! EXIT!!! His play is NOT shorting bonds! It's GOLD!! SILVER!! And a little BITCOIN!!!","tail":"DO YOU HEAR ME?!!","gapAfter":2}
+  ],
+  "takes": [
+    {"cues":["intro","measure","covid","proof","ai","others","japan"],"seed":3},
+    {"cues":["dollar"],"seed":1},
+    {"cues":["loop"],"seed":1},
+    {"cues":["gold"],"seed":1}
+  ]}]
+}
