+# The Bondfire / Gromen, in his own words (dramatized)
+
+One Scene Plan, one diagram, no cuts. An AI voice performs Luke Gromen's
+published thesis in the first person. It is not his voice, not a recording, and
+not endorsed by him; the film says "DRAMATIZED" on screen and the page says so too.
+
+## Change the script, rebuild, ship
+
+1. Edit `narration/script.json`. Each entry in `clips[0].blocks` is one line:
+   - `cue`: the id the animation is keyed to. Keep the eleven ids and their order:
+     `intro, fiscal, foreign, gold, supply, credit, loop, crisis, rescue, assets, bondholders`.
+   - `text`: the caption.
+   - `say`: what the voice model actually speaks (capitals and `!` push the delivery).
+   - `lead` / `tail` (optional): words spoken before/after the line to push the
+     delivery, then cut out.
+   - `gapAfter`: seconds of silence after the line.
+
+   `clips[0].takes` groups cues into generations, each with a `seed`; change a
+   seed to get a different read of that take.
+2. Check it quickly (regenerates the voice, then one still per cue, no render):
+
+       ./build.sh --voice --stills
+
+   Look at `output/gromen-certainty-stills/` (repo root). `NN-<cue>.png` is 1.5 s
+   into each line; the last one is the final frame.
+3. Ship it (voice, full render, public page, deploy):
+
+       ./build.sh --voice --publish
+
+Drop `--voice` when only the visuals changed. `./build.sh --help` lists the
+options and the environment variables for the toolchain and paths.
+
+## Where things are
+
+- `src/main.rs`: the diagram and choreography. Every beat is placed relative to
+  a cue's start or end in `narration/timeline.json`, never at an absolute time.
+  The lower-left beat labels are the `captions` table in `build`.
+- `voice.py`: writes `narration/timeline.json` and `narration/continuous.m4a`.
+- `package.py`: turns `output/gromen-certainty-raw.mp4` into
+  `output/gromen-certainty-public/` (page, captions, poster, `source.zip`).
+
+Colour emoji and flag glyphs only render in the screen-space text (header and
+beat labels). Text inside the diagram is monochrome, so the China and Japan
+flags there are drawn from rectangles and circles.
+
+`TIMELINE=/path/to/timeline.json ./build.sh --stills` checks the choreography
+against other timings without touching the narration.
diff --git a/scenes/gromen-certainty/build.sh b/scenes/gromen-certainty/build.sh
new file mode 100755
index 0000000..6d4f7b0
--- /dev/null
+++ b/scenes/gromen-certainty/build.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+# One command for the whole film: narration -> plan -> render -> public page.
+#
+#   build.sh [--voice] [--stills] [--publish [--public]]
+#
+#   --voice    regenerate narration/ from narration/script.json (needs tts-lab + GPU)
+#   --stills   write one PNG per cue to output/gromen-certainty-stills/ and stop
+#              (seconds, instead of the multi-minute full render)
+#   --publish  after packaging, copy the page to the reports dir and deploy it
+#   --public   with --publish: deploy publicly instead of privately
+#
+# Environment:
+#   CARGO             cargo command                (default: cargo +1.95.0)
+#   CARGO_TARGET_DIR  share a build cache between worktrees
+#   TTS_LAB_DIR       tts-lab checkout             (default: $HOME/devfs/repos/kkrausse/random/tts-lab)
+#   REPORTS_DIR       where --publish copies to    (default: $HOME/devfs/repos/kkrausse/reports)
+#   DEPLOY            deploy script                (default: $HOME/devfs/repos/kkrausse/random/scripts/deploy-artifact.sh)
+#   TIMELINE          use another timeline.json for the plan and stills
+set -euo pipefail
+
+HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+ROOT="$(cd -- "$HERE/../.." && pwd)"
+NAME=gromen-certainty
+CARGO="${CARGO:-cargo +1.95.0}"
+TTS_LAB_DIR="${TTS_LAB_DIR:-$HOME/devfs/repos/kkrausse/random/tts-lab}"
+REPORTS_DIR="${REPORTS_DIR:-$HOME/devfs/repos/kkrausse/reports}"
+DEPLOY="${DEPLOY:-$HOME/devfs/repos/kkrausse/random/scripts/deploy-artifact.sh}"
+PLAN="$HERE/continuous.json"
+OUT="$ROOT/output"
+
+voice=0 stills=0 publish=0 public=0
+for arg in "$@"; do
+  case "$arg" in
+    --voice) voice=1 ;;
+    --stills) stills=1 ;;
+    --publish) publish=1 ;;
+    --public) public=1 ;;
+    -h | --help) sed -n '2,19p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
+    *) echo "build.sh: unknown option $arg (see --help)" >&2; exit 2 ;;
+  esac
+done
+step() { printf '\n==> %s\n' "$*"; }
+
+cd "$ROOT"
+
+if ((voice)); then
+  step "narration: voice.py (TTS_LAB_DIR=$TTS_LAB_DIR)"
+  python="$TTS_LAB_DIR/orpheus/.venv/bin/python"
+  [[ -x "$python" ]] || { echo "no Orpheus python at $python; set TTS_LAB_DIR" >&2; exit 1; }
+  TTS_LAB_DIR="$TTS_LAB_DIR" "$python" "$HERE/voice.py"
+else
+  step "narration: kept as is (pass --voice to regenerate)"
+fi
+
+step "plan: $PLAN"
+$CARGO run -q -p "psychopomp-$NAME"
+
+step "renderer: release build"
+$CARGO build -q --release -p psychopomp-render
+BIN="${CARGO_TARGET_DIR:-$ROOT/target}/release/psychopomp"
+"$BIN" plan validate "$PLAN"
+
+if ((stills)); then
+  dir="$OUT/$NAME-stills"
+  step "stills: one per cue -> $dir"
+  rm -rf "$dir"
+  mkdir -p "$dir"
+  # The narration starts 2 s into the film; sample 1.5 s into each block, and
+  # once more at the last frame to see what the film ends on.
+  python3 - "${TIMELINE:-$HERE/narration/timeline.json}" <<'PY' |
+import json, sys
+clip = json.load(open(sys.argv[1]))[0]
+for i, block in enumerate(clip["blocks"]):
+    print(f"{i:02d}-{block['cue']} {2.0 + block['start'] + 1.5:.2f}")
+print(f"{len(clip['blocks']):02d}-end {clip['duration'] + 4.9:.2f}")
+PY
+  while read -r name at; do
+    "$BIN" plan frame "$PLAN" "$at" "$dir/$name.png" --theme neutral >/dev/null
+    echo "  $name.png  @ ${at}s"
+  done
+  step "done (stills only; no render, no package)"
+  exit 0
+fi
+
+mkdir -p "$OUT"
+step "render: $OUT/$NAME-raw.mp4 (several minutes)"
+"$BIN" plan render "$PLAN" "$OUT/$NAME-raw.mp4" --theme neutral
+
+step "package: $OUT/$NAME-public/"
+python3 "$HERE/package.py"
+
+if ((publish)); then
+  dest="$REPORTS_DIR/gromen-bondfire-certainty-$(date +%Y%m%d)"
+  step "publish: $dest"
+  mkdir -p "$dest"
+  cp -a "$OUT/$NAME-public/." "$dest/"
+  if ((public)); then "$DEPLOY" --public "$dest"; else "$DEPLOY" "$dest"; fi
+fi
+step "done"
