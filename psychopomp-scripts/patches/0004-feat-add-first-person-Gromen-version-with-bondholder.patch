+  "basis": "An AI-voiced dramatization of Luke Gromen's thesis, in his words and phrases from FFTT \"Tree Rings\", October 2, 2026. It is not a recording of him and he did not narrate it.",
+  "voice": "Orpheus 3B, voice dan, temperature 0.9, speaking in the first person as Gromen. `text` is the caption. `say` is what the model speaks for it. `lead` and `tail` are spoken around the block to push the delivery, then cut out. `takes` groups blocks into generations with their seeds.",
+  "clips": [{"id":"continuous","title":"THE BONDFIRE / A MATHEMATICAL CERTAINTY","blocks":[
+    {"cue":"intro","text":"I'm Luke Gromen. This is one system, and it's breaking.","say":"I'm Luke Gromen. This is one system, and it's breaking.","gapAfter":1},
+    {"cue":"fiscal","text":"Entitlements and interest already exceed tax receipts. Nobody can cut that.","say":"Entitlements and interest already exceed tax receipts. Nobody can cut that.","gapAfter":2},
+    {"cue":"foreign","text":"China and East Asia stopped recycling surpluses into our Treasuries.","say":"China and East Asia stopped recycling surpluses into our Treasuries.","gapAfter":2},
+    {"cue":"gold","text":"China's money is going into gold instead.","say":"China's money is going into gold instead!","gapAfter":2},
+    {"cue":"supply","text":"Oil and copper shocks keep inflation and yields up.","say":"Oil and copper shocks keep inflation and yields up!","gapAfter":2},
+    {"cue":"credit","text":"A I borrowing is crowding out the whole bond market.","say":"AI borrowing is crowding out the whole bond market!","gapAfter":2},
+    {"cue":"loop","text":"Higher yields. Higher interest. Bigger deficits. More debt. Wash, rinse, repeat.","lead":"Ugh! And it gets WORSE! It gets SO much worse!!","say":"Higher yields! Higher interest! Bigger deficits! More debt! Wash! Rinse! REPEAT!!","tail":"Are you KIDDING me?!","gapAfter":4},
+    {"cue":"crisis","text":"Forced selling. The Treasury market collapses. The collateral breaks.","lead":"NO! NO, NO, NO!! I TOLD you this would happen!!","say":"Forced selling! The Treasury market COLLAPSES!! The collateral BREAKS!!!","tail":"<groan> I TOLD YOU!! I TOLD YOU!!!","gapAfter":3},
+    {"cue":"rescue","text":"The Fed and Treasury print. They have no choice.","lead":"OH MY GOD!! DO SOMETHING!! DO SOMETHING RIGHT NOW!!!","say":"THE FED! And Treasury! PRINT!!! They have NO! CHOICE!!!","tail":"NO! NO!! DON'T YOU DARE WALK AWAY FROM ME!!","gapAfter":2},
+    {"cue":"assets","text":"The dollar is devalued against gold. Hard assets soar.","lead":"NO! NO!! DON'T YOU DARE WALK AWAY FROM ME!!","say":"THE DOLLAR! Is DEVALUED! Against GOLD!!! HARD! ASSETS! SOAR!!!","tail":"<groan> GET OUT! I SAID GET OUT!!!","gapAfter":2},
+    {"cue":"bondholders","text":"Bondholders are inflated away. Crushed. That is a mathematical certainty.","lead":"NO!! SHUT UP!! LISTEN TO ME!!!","say":"BONDHOLDERS! ARE! INFLATED! AWAY!!! CRUSHED!!! THAT! IS! A! MATHEMATICAL! CERTAINTY!!!!","tail":"DO YOU HEAR ME?!! DO YOU HEAR ME?!!!","gapAfter":2}
+  ],
+  "takes": [
+    {"cues":["intro","fiscal","foreign","gold","supply","credit"],"seed":1},
