+        card(
+            "dollar",
+            400.0,
+            715.0,
+            "DOLLAR RELEASE VALVE",
+            "purchasing power falls",
+            "warning",
+            500.0,
+        ),
+        card(
+            "hard",
+            1520.0,
+            715.0,
+            "GOLD / SILVER / BTC",
+            "hard assets outperform",
+            "accent",
+            505.0,
+        ),
+        // Flags are drawn from primitives: stage text has no colour glyphs.
+        flag_field("china-flag", 1765.0 - 82.0, 237.0, "error"),
+        flag_dot("china-dot", 1765.0 - 91.0, 232.0, 6.0, "warning"),
+        flag_field("japan-flag", 1410.0 - 82.0, 237.0, "plain"),
+        flag_dot("japan-dot", 1410.0 - 82.0, 237.0, 8.0, "error"),
+        // China's bid goes to gold instead of Treasuries.
+        json!({"kind":"orb","id":"gold","at":[GOLD[0],GOLD[1],0],"radius":36,"points":260,"tone":"accent"}),
+        label("gold-label", GOLD[0] - 180.0, GOLD[1] - 12.0, "GOLD", 24.0, "accent"),
+        label("gold-note", GOLD[0] - 180.0, GOLD[1] + 18.0, "China's surplus -> gold", 17.0, "muted"),
+        // The bondholders are on stage the whole film, then destroyed for good.
+        label("holders-title", 800.0, 92.0, "BONDHOLDERS", 24.0, "warning"),
+        label("holders-note", 800.0, 124.0, "LT UST holders / bond mafia", 17.0, "muted"),
+        label("holders-dead", 800.0, 124.0, "INFLATED AWAY", 24.0, "error"),
+    ]
+    .into_iter()
+    .chain(HOLDERS.iter().flat_map(|(id, x, name)| {
+        [
+            json!({"kind":"orb","id":id,"at":[x,HOLDER_Y,0],"radius":40,"points":300,"tone":"request"}),
+            // Embers of the same orb: they fall and stay where they land.
+            json!({"kind":"orb","id":format!("{id}-ash"),"at":[x,HOLDER_Y,0],"radius":40,"points":300,"tone":"error"}),
+            label(&format!("{id}-name"), *x, HOLDER_Y + 64.0, name, 18.0, "plain"),
+            label(&format!("{id}-dead"), *x, HOLDER_Y + 64.0, "INFLATED AWAY", 18.0, "error"),
+        ]
+    }))
+    .collect::<Vec<_>>();
+    let edges: [Edge<'_>; 17] = [
+        ("china-ust", "china", "h-foreign", "request"),
+        ("japan-ust", "japan", "h-foreign", "request"),
+        ("china-gold", "china", "gold", "accent"),
+        ("fiscal-feed", "fiscal", "issuance", "warning"),
+        ("foreign-feed", "foreign", "yields", "request"),
+        ("supply-feed", "supply", "yields", "error"),
+        ("credit-feed", "credit", "core", "error"),
+        ("loop-a", "yields", "interest", "error"),
+        ("loop-b", "interest", "deficit", "error"),
+        ("loop-c", "deficit", "issuance", "error"),
+        ("loop-d", "issuance", "yields", "error"),
+        ("impact", "deficit", "core", "error"),
+        ("rescue", "fed", "core", "request"),
+        ("balance", "fed", "reserves", "request"),
+        ("money", "fed", "m2", "plain"),
+        ("release", "core", "dollar", "warning"),
+        ("assets", "core", "hard", "accent"),
+    ];
+    let elements = nodes
+        .into_iter()
+        .chain(edges.into_iter().flat_map(path))
+        .collect::<Vec<_>>();
+    let mut plan: StagePlan = serde_json::from_value(json!({"elements":elements}))?;
+    plan.post = StagePost::RESTRAINED;
+    Ok(plan)
+}
+fn text(
+    scene: &mut PlanBuilder,
+    id: &str,
+    value: &str,
+    y: f32,
+    size: f32,
+    tone: Tone,
+) -> Result<Caption> {
+    Caption::declare(
+        scene,
+        id,
+        &CaptionPlan::line([80.0, y], size, vec![CaptionSpanPlan::new(value, tone)]),
+    )
+}
+fn launch(scene: &mut PlanBuilder, s: &Stage, at: u64, edge: &str, to: &str, travel: f32) {
+    scene.at(
+        at,
+        s.connect(edge, 0.3)
+            .then(s.send(format!("p-{edge}"), travel))
+            .with(sfx::SEND.beat(format!("s-{edge}-{at}"), -20.0))
+            .then(s.land(to)),
+    );
+}
+fn amalgamate(scene: &mut PlanBuilder, s: &Stage, c: &Clip, cue: &str) {
+    let (_, destination, actors) = GROUPS.iter().find(|g| g.0 == cue).unwrap();
+    for (i, id) in actors.iter().enumerate() {
+        let el = s.plan().elements.iter().find(|el| el.id() == *id).unwrap();
+        let [x, y, _] = match el {
+            StageElement::Card { at, .. } | StageElement::Shape { at, .. } => *at,
+            _ => unreachable!(),
+        };
+        let at = c.at(cue) + seconds(i as f64 * 0.11);
+        scene.at(
+            at,
+            s.glide(format!("{id}.x"), destination[0] - x, 1.0)
+                .also(s.glide(format!("{id}.y"), destination[1] - y, 1.0))
+                .also(s.glide(format!("{id}.scale"), 0.1, 1.0))
+                .also(s.to(format!("{id}.opacity"), 0.0, 1.0)),
+        );
+    }
+    scene.at(c.at(cue) + seconds(0.65), s.fade_in(cue, 1.0, 0.55));
+}
+/// The bondholders swell, burst one after another, and stay destroyed: three
+/// bursts plus the Treasury orb itself, against the single burst at `crisis`.
+/// Nothing here calls `unburst`.
+fn finale(scene: &mut PlanBuilder, s: &Stage, at: u64) {
+    let wind = 1.1;
+    let boom = at + seconds(wind as f64);
+    scene.at(at, s.to("camera.zoom", 1.0, wind));
+    scene.at(
+        boom.saturating_sub(sfx::RISER.length()),
+        sfx::RISER.beat("riser-final", -21.0),
+    );
+    for id in ["holders-note", "gold-note"] {
+        scene.at(at, s.to(format!("{id}.opacity"), 0.0, 0.4));
+    }
+    for (i, (id, _, _)) in HOLDERS.into_iter().enumerate() {
+        let hit = boom + seconds(i as f64 * 0.32);
+        scene.at(
+            at,
+            s.charge(id, 1.0, wind)
+                .also(s.glide(format!("{id}.scale"), 1.7, wind))
+                .also(s.to(format!("{id}.hurt"), 1.0, wind))
+                .also(s.to(format!("{id}-name.opacity"), 0.0, 0.4)),
+        );
+        scene.at(
+            hit,
+            s.clock_for(format!("{id}.burst"), 5.2)
+                .with(sfx::BOOM.beat(format!("boom-{id}"), -8.0)),
+        );
+        scene.at(hit + seconds(0.1), s.jolt([0.4 - i as f32 * 0.5, 1.0], 1.3));
+        // Embers fall out of the fireball and stay where they land. Short of a
+        // full shatter, which would fade them out.
+        scene.at(
+            hit + seconds(0.2),
+            s.fade_in(format!("{id}-ash"), 0.85, 0.5).also(s.to(
+                format!("{id}-ash.shatter"),
+                0.7,
+                3.2,
+            )),
+        );
+        scene.at(
+            hit + seconds(0.9),
+            s.fade_in(format!("{id}-dead"), 1.0, 0.35),
+        );
+    }
+    let last = boom + seconds(0.96);
+    scene.at(
+        last,
+        s.clock_for("core.burst", 5.2)
+            .with(sfx::BOOM.beat("boom-core", -7.0)),
+    );
+    scene.at(last + seconds(0.1), s.jolt([0.0, -1.0], 1.6));
+    scene.at(last, s.to("core-label.opacity", 0.0, 0.5));
+    scene.at(last, s.to("feedback.opacity", 0.0, 0.5));
+    scene.at(last + seconds(0.5), s.fade_in("holders-dead", 1.0, 0.35));
+    for id in [
+        "yields", "interest", "deficit", "issuance", "fed", "reserves", "m2", "dollar",
+    ] {
+        scene.at(
+            last + seconds(0.3),
+            s.hit(format!("{id}.damage"), 1.0, 0.55)
+                .also(s.to(format!("{id}.opacity"), 0.45, 1.2)),
+        );
+    }
+    // Hard assets are the only thing left standing, and they grow.
+    scene.at(
+        last + seconds(0.9),
+        s.glide("hard.scale", 1.18, 1.2)
+            .also(s.glide("gold.scale", 1.8, 1.2))
+            .also(s.land("hard"))
+            .also(s.land("gold"))
+            .with(sfx::BLOOM.beat("bloom-final", -15.0)),
+    );
+}
+fn build(c: &Clip) -> Result<ScenePlan> {
+    let plan = diagram()?;
+    let mut scene = PlanBuilder::new("bondfire-certainty", seconds(c.duration + 5.0));
+    scene.media(MediaPlan {
+        id: "voice".into(),
+        path: "narration/continuous.m4a".into(),
+        kind: MediaKindPlan::Audio,
+        role: MediaRolePlan::Script,
+        source_start_nanos: 0,
+        source_end_nanos: seconds(c.duration),
+        timeline_start_nanos: seconds(2.0),
+        timeline_end_nanos: seconds(c.duration + 2.0),
+        gain_db: 0.0,
+    });
+    let s = Stage::declare(&mut scene, "stage", &plan)?;
+    let header = text(
+        &mut scene,
+        "title",
+        "THE BONDFIRE 🔥 / ONE SYSTEM",
+        66.0,
+        34.0,
+        Tone::Plain,
+    )?;
+    let tag = text(
+        &mut scene,
+        "tag",
+        "GROMEN'S THESIS / DRAMATIZED",
+        112.0,
+        19.0,
+        Tone::Warning,
+    )?;
+    scene.at(seconds(0.1), header.type_in(110.0, 0.0));
+    scene.at(seconds(0.3), tag.show());
+    let hidden = [
+        "fiscal",
+        "foreign",
+        "supply",
+        "credit",
+        "fed",
+        "reserves",
+        "m2",
+        "dollar",
+        "hard",
+        "gold",
+        "gold-label",
+        "gold-note",
+        "holders-dead",
+        "h-pensions-ash",
+        "h-banks-ash",
+        "h-foreign-ash",
+        "h-pensions-dead",
+        "h-banks-dead",
+        "h-foreign-dead",
+    ];
+    for el in &plan.elements {
+        let id = el.id();
+        match el {
+            StageElement::Card { .. }
+            | StageElement::Label { .. }
+            | StageElement::Orb { .. }
+            | StageElement::Shape { .. } => {
+                if hidden.contains(&id) {
+                    scene.at(0, s.channel(format!("{id}.opacity"), 0.0));
+                } else {
+                    scene.at(seconds(0.5), s.fade_in(id, 1.0, 0.6));
+                }
+            }
+            StageElement::Path { .. } => {
+                scene.at(0, s.channel(format!("{id}.draw"), 0.0));
+            }
+            _ => {}
+        }
+    }
+    let captions = [
+        ("intro", "ONE MACHINE 🔥"),
+        ("fiscal", "FISCAL LOAD 💸"),
+        ("foreign", "🇨🇳 🇯🇵 EAST ASIA STOPS BUYING"),
+        ("gold", "🇨🇳 CHINA'S SURPLUS → GOLD 🥇"),
+        ("supply", "SUPPLY SQUEEZE ⛽"),
+        ("credit", "CREDIT STRESS 🏦"),
+        ("loop", "THE LOOP ACCELERATES 📈"),
+        ("crisis", "COLLATERAL BREAKS 💥"),
+        ("rescue", "THE FED PRINTS 💵"),
+        ("assets", "DOLLAR DOWN 📉 / GOLD, SILVER, BTC UP 🥇"),
+        ("bondholders", "💥 BONDHOLDERS INFLATED AWAY 💥"),
+    ];
+    for (i, (cue, value)) in captions.iter().enumerate() {
+        let cap = text(
+            &mut scene,
+            &format!("note-{i}"),
+            value,
+            1020.0,
+            25.0,
+            Tone::Plain,
+        )?;
+        scene.at(c.at(cue), cap.show());
+        if let Some((next, _)) = captions.get(i + 1) {
+            scene.at(c.at(next) - seconds(0.16), cap.hide());
+        }
+    }
+    // China and Japan recycle surpluses into Treasuries, until they do not.
+    for (i, at) in [c.at("intro") + seconds(0.9), c.at("fiscal") + seconds(0.4)]
+        .into_iter()
+        .enumerate()
+    {
+        for (j, edge) in ["china-ust", "japan-ust"].into_iter().enumerate() {
+            launch(
+                &mut scene,
+                &s,
+                at + seconds((i + j) as f64 * 0.25),
+                edge,
+                "h-foreign",
+                0.6,
+            );
+        }
+    }
+    for edge in ["china-ust", "japan-ust"] {
+        scene.at(c.at("foreign"), s.to(format!("{edge}.draw"), 0.0, 0.5));
+    }
+    scene.at(
+        c.at("foreign") + seconds(0.35),
+        s.hit("h-foreign.hurt", 1.0, 0.35)
+            .with(sfx::SEVER.beat("sever", -18.0)),
+    );
+    // China stays on stage and redirects its flow into gold.
+    for id in ["gold", "gold-label", "gold-note"] {
+        scene.at(c.at("gold"), s.fade_in(id, 1.0, 0.6));
+    }
+    for i in 0..3 {
+        launch(
+            &mut scene,
+            &s,
+            c.at("gold") + seconds(0.5 + i as f64 * 0.9),
+            "china-gold",
+            "gold",
+            0.5,
+        );
+    }
+    scene.at(c.at("gold") + seconds(1.0), s.glide("gold.scale", 1.4, 2.4));
+    for (cue, edge, to) in [
+        ("fiscal", "fiscal-feed", "issuance"),
+        ("foreign", "foreign-feed", "yields"),
+        ("supply", "supply-feed", "yields"),
+        ("credit", "credit-feed", "core"),
+    ] {
+        amalgamate(&mut scene, &s, c, cue);
+        launch(&mut scene, &s, c.at(cue) + seconds(1.25), edge, to, 0.65);
+    }
+    // The same four arrows accelerate; no scene change replaces the diagram.
+    for (i, (edge, to)) in [
+        ("loop-a", "interest"),
+        ("loop-b", "deficit"),
+        ("loop-c", "issuance"),
+        ("loop-d", "yields"),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        launch(
+            &mut scene,
+            &s,
+            c.at("loop") + seconds(i as f64 * 1.25),
+            edge,
+            to,
+            0.55,
+        );
+    }
+    for lap in 0..3 {
+        for (i, (edge, to)) in [
+            ("loop-a", "interest"),
+            ("loop-b", "deficit"),
+            ("loop-c", "issuance"),
+            ("loop-d", "yields"),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            launch(
+                &mut scene,
+                &s,
+                c.at("loop") + seconds(5.4 + lap as f64 * 1.4 + i as f64 * 0.35),
+                edge,
+                to,
+                0.35,
+            );
+        }
+    }
+    scene.at(c.at("loop"), s.charge("core", 0.9, 7.0));
+    scene.at(c.at("loop"), s.to("camera.zoom", 1.05, 3.0));
+    launch(&mut scene, &s, c.at("crisis"), "impact", "core", 0.6);
+    let boom = c.end("crisis") + seconds(0.12);
+    scene.at(
+        boom.saturating_sub(sfx::RISER.length()),
+        sfx::RISER.beat("riser", -23.0),
+    );
+    scene.at(
+        boom,
+        s.clock_for("core.burst", 5.2)
+            .with(sfx::BOOM.beat("boom", -9.0)),
+    );
+    scene.at(boom + seconds(0.12), s.jolt([0.8, -0.3], 0.65));
+    for id in ["interest", "issuance", "credit", "foreign"] {
+        scene.at(boom + seconds(0.4), s.hit(format!("{id}.damage"), 1.0, 0.4));
+    }
+    // The holders take the first hit here; the finale finishes them.
+    for (id, _, _) in HOLDERS {
+        scene.at(boom + seconds(0.5), s.hit(format!("{id}.hurt"), 1.0, 0.45));
+    }
+    // Reconstitute the SAME Treasury orb as support enters the SAME system.
+    scene.at(c.at("rescue"), s.fade_in("fed", 1.0, 0.5));
+    launch(
+        &mut scene,
+        &s,
+        c.at("rescue") + seconds(0.6),
+        "rescue",
+        "core",
+        0.8,
+    );
+    scene.at(c.at("rescue") + seconds(1.8), s.unburst("core", 1.4));
+    scene.at(c.at("rescue") + seconds(1.8), s.charge("core", 0.0, 0.5));
+    for edge in ["loop-a", "loop-b", "loop-c", "loop-d"] {
+        scene.at(
+            c.at("rescue") + seconds(2.0),
+            s.to(format!("{edge}.opacity"), 0.22, 0.8),
+        );
+    }
+    // Keep the causal subgroups visible: park them at the perimeter rather
+    // than deleting the original pressures when the rescue arrives.
+    for (old, dx, dy) in [
+        ("fiscal", -160.0, -135.0),
+        ("foreign", -40.0, -135.0),
+        ("supply", -160.0, 155.0),
+        ("credit", 180.0, 155.0),
+    ] {
+        scene.at(
+            c.at("rescue") + seconds(2.0),
+            s.glide(format!("{old}.x"), dx, 1.0)
+                .also(s.glide(format!("{old}.y"), dy, 1.0))
+                .also(s.glide(format!("{old}.scale"), 0.65, 1.0))
+                .also(s.to(format!("{old}.opacity"), 0.5, 1.0)),
+        );
+    }
+    for id in ["reserves", "m2"] {
+        scene.at(c.at("rescue") + seconds(2.4), s.fade_in(id, 1.0, 0.7));
+    }
+    launch(
+        &mut scene,
+        &s,
+        c.at("rescue") + seconds(2.5),
+        "balance",
+        "reserves",
+        0.65,
+    );
+    launch(
+        &mut scene,
+        &s,
+        c.at("rescue") + seconds(3.3),
+        "money",
+        "m2",
+        0.65,
+    );
+    for id in ["dollar", "hard"] {
+        scene.at(c.at("assets"), s.fade_in(id, 1.0, 0.7));
+    }
+    launch(
+        &mut scene,
+        &s,
+        c.at("assets") + seconds(0.7),
+        "release",
+        "dollar",
+        0.75,
+    );
+    launch(
+        &mut scene,
+        &s,
+        c.at("assets") + seconds(1.8),
+        "assets",
+        "hard",
+        0.75,
+    );
+    scene.at(
+        c.at("assets") + seconds(2.8),
+        s.land("hard").with(sfx::BLOOM.beat("bloom", -17.0)),
+    );
+    scene.at(
+        c.at("assets") + seconds(1.8),
+        s.glide("gold.scale", 1.6, 1.5),
+    );
+    finale(&mut scene, &s, c.at("bondholders"));
+    Ok(scene.finish()?)
+}
+fn main() -> Result<()> {
+    run(PathBuf::from(env!("CARGO_MANIFEST_DIR")))
+}
+/// Build the plan and captions for the scene directory holding `narration/timeline.json`.
+fn run(here: PathBuf) -> Result<()> {
+    // TIMELINE points the choreography at another timeline, to check it
+    // against timings other than the recorded narration's.
+    let timeline = std::env::var_os("TIMELINE")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| here.join("narration/timeline.json"));
+    let clips: Vec<Clip> = serde_json::from_slice(&std::fs::read(timeline)?)?;
+    let c = &clips[0];
+    build(c)?.write_or_print(Some(here.join("continuous.json")))?;
+    let stamp = |t: f64| {
+        let ms = (t * 1000.0).round() as u64;
+        format!(
+            "{:02}:{:02}:{:02}.{:03}",
+            ms / 3600000,
+            ms / 60000 % 60,
+            ms / 1000 % 60,
+            ms % 1000
+        )
+    };
+    let vtt = "WEBVTT\n\n".to_string()
+        + &c.blocks
+            .iter()
+            .map(|b| {
+                format!(
+                    "{} --> {}\n{}\n\n",
+                    stamp(2.0 + b.start),
+                    stamp(2.0 + b.end),
+                    b.text
+                )
+            })
+            .collect::<String>();
+    std::fs::write(here.join("captions.vtt"), vtt)?;
+    println!("ONE CONTINUOUS SCENE / {:.1}s", c.duration + 5.0);
+    Ok(())
+}
