+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::path::PathBuf;
+
+#[derive(Deserialize)]
+struct Block {
+    cue: String,
+    text: String,
+    start: f64,
+    end: f64,
+}
+#[derive(Deserialize)]
+struct Clip {
+    duration: f64,
+    blocks: Vec<Block>,
+}
+impl Clip {
+    fn block(&self, cue: &str) -> &Block {
+        self.blocks
+            .iter()
+            .find(|b| b.cue == cue)
+            .unwrap_or_else(|| panic!("narration/timeline.json has no cue '{cue}'"))
+    }
+    fn at(&self, cue: &str) -> u64 {
+        seconds(2.0 + self.block(cue).start)
+    }
+    fn end(&self, cue: &str) -> u64 {
+        seconds(2.0 + self.block(cue).end)
+    }
+}
