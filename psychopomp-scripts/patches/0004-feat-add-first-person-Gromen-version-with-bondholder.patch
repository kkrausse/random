+//! One scene, one diagram, one reversible timeline. No reels, cuts or chapter resets.
+//! Gromen in the first person: China and Japan leave, China buys gold, and the
+//! bondholders are destroyed in the finale and never reassemble.
+use anyhow::Result;
+use psychopomp::{
+    author::{PlanBuilder, seconds},
+    caption::{CaptionPlan, CaptionSpanPlan},
+    plan::{MediaKindPlan, MediaPlan, MediaRolePlan, ScenePlan},
+    score::{Beat, Caption, Stage},
+    sfx,
+    stage::{StageElement, StagePlan, StagePost},
+    tone::Tone,
