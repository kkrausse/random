diff --git a/scenes/gromen-continuous/src/main.rs b/scenes/gromen-continuous/src/main.rs
index ea5aa5f..7ef6406 100644
--- a/scenes/gromen-continuous/src/main.rs
+++ b/scenes/gromen-continuous/src/main.rs
@@ -613,7 +613,11 @@ fn build(c: &Clip) -> Result<ScenePlan> {
     Ok(scene.finish()?)
 }
 fn main() -> Result<()> {
-    let here = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    run(PathBuf::from(env!("CARGO_MANIFEST_DIR")))
+}
+/// Build the plan and captions for the scene directory holding `narration/timeline.json`.
+/// `scenes/gromen-intense` reuses this choreography with its own narration.
+pub fn run(here: PathBuf) -> Result<()> {
     let clips: Vec<Clip> =
         serde_json::from_slice(&std::fs::read(here.join("narration/timeline.json"))?)?;
     let c = &clips[0];
