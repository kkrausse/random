+{
+  "title": "The Bondfire / One System (intense narration)",
+  "basis": "A shortened, continuous-diagram dramatization of Gromen's October 2, 2026 thesis. Not a forecast.",
+  "voice": "Orpheus 3B, voice dan, temperature 0.9. `text` is the caption. `say` is what the model speaks for it. `lead` and `tail` are spoken around the block to push the delivery, then cut out. `takes` groups blocks into generations with their seeds.",
+  "clips": [{"id":"continuous","title":"THE BONDFIRE / ONE SYSTEM","blocks":[
+    {"cue":"intro","text":"One system. Gromen's scenario.","say":"One system. Gromen's scenario.","gapAfter":1},
+    {"cue":"fiscal","text":"Promises and politics keep deficits large.","say":"Promises and politics keep deficits large.","gapAfter":2},
+    {"cue":"foreign","text":"China and other investors recycle less into Treasuries.","say":"China and other investors recycle less into Treasuries.","gapAfter":2},
+    {"cue":"supply","text":"Oil and copper shocks keep inflation pressure alive.","say":"Oil and copper shocks keep inflation pressure alive!","gapAfter":2},
+    {"cue":"credit","text":"A I borrowing and credit losses add stress.","say":"AI borrowing and credit losses add stress!","gapAfter":2},
+    {"cue":"loop","text":"Higher yields. Higher interest costs. More deficits. More debt.","lead":"Ugh! And it gets WORSE! It gets SO much worse!!","say":"Higher yields! Higher interest costs! More deficits! More! Debt!!","tail":"Are you KIDDING me?!","gapAfter":6},
+    {"cue":"crisis","text":"Forced selling breaks the collateral engine.","lead":"NO! NO, NO, NO!! I TOLD you this would happen!!","say":"Forced selling! BREAKS! The collateral engine!!!","tail":"<groan> I TOLD YOU!! I TOLD YOU!!!","gapAfter":4},
+    {"cue":"rescue","text":"The Fed and Treasury step in.","lead":"OH MY GOD!! DO SOMETHING!! DO SOMETHING RIGHT NOW!!!","say":"THE FED! And Treasury! STEP IN!!!","tail":"NO! NO!! DON'T YOU DARE WALK AWAY FROM ME!!","gapAfter":3},
+    {"cue":"assets","text":"Gromen's ending: dollar debasement. Hard assets rise.","lead":"NO! NO!! DON'T YOU DARE WALK AWAY FROM ME!!","say":"Gromen's ending! DOLLAR! Debasement!!! HARD! ASSETS! RISE!!!","tail":"<groan> GET OUT! I SAID GET OUT!!!","gapAfter":2},
+    {"cue":"caveat","text":"Liquidity is not automatically M two. This ending is disputed.","lead":"NO!! SHUT UP!! LISTEN TO ME!!!","say":"LIQUIDITY! IS! NOT! AUTOMATICALLY! M2!!! THIS! ENDING! IS! DISPUTED!!!!","tail":"DO YOU HEAR ME?!! DO YOU HEAR ME?!!!","gapAfter":2}
