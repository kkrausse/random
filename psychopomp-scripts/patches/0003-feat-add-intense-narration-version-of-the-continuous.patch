+++ b/scenes/gromen-intense/voice.py
@@ -0,0 +1,390 @@
+#!/usr/bin/env python
+"""Intense narration: Orpheus takes that escalate, aligned back onto the script.
+
+    <orpheus python> scenes/gromen-intense/voice.py                       # rebuild from script.json
+    <orpheus python> scenes/gromen-intense/voice.py --audition 1-8 --only 3  # compare seeds for take 3
+    <orpheus python> scenes/gromen-intense/voice.py --cached              # reuse audition takes
+
+Orpheus has no emotion or volume control; how a line is delivered follows from
+the text around it. Each block has a `say` form (plain -> `!` and capitals).
+From the feedback loop onward a block also has a `lead`: a few angry words
+spoken just before it to push the delivery, which are then dropped.
+
+`takes` in script.json groups the blocks into generations. The calm opening is
+one continuous take. Each later block is its own take, because the push from a
+lead only lasts about one sentence and long shouted takes come out garbled.
+
+Whisper word timestamps locate each block's words in its take. Audio is cut
+only in silence (never inside a block): leads are removed there, and digital
+silence is inserted until each pause equals the script's `gapAfter`. Takes
+therefore only ever meet across a pause of a second or more.
+
+Needs the tts-lab Orpheus environment (TTS_LAB_DIR) and ffmpeg. No paid API.
+"""
+import argparse
+import difflib
+import json
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+TTS_LAB = Path(os.environ.get("TTS_LAB_DIR", "tts-lab"))
+sys.path.insert(0, str(TTS_LAB / "orpheus"))
+import generate as g  # noqa: E402  (before numpy/torch: it re-execs to fix LD_LIBRARY_PATH)
+import numpy as np  # noqa: E402
+import soundfile as sf  # noqa: E402
+
+HERE = Path(__file__).resolve().parent
+OUT = HERE / "narration"
+VOICE = "dan"
+TEMPERATURE = 0.9
+MAX_TOKENS = 4000  # ~49 s of audio; the longest take is ~20 s, so it cannot truncate
+N_CTX = 8192
+RATE = g.SAMPLE_RATE
+HOP = RATE // 100  # 10 ms analysis frames
+FADE = RATE // 100  # 10 ms fade each side of a cut
+MIN_SILENCE = 5  # frames; a cut needs at least 50 ms of silence
+RAMP_DB = -6.0  # first block's level relative to the last; linear in dB over the blocks
+TARGET_RMS_DB = -16.0  # RMS of the last block after mastering
+PEAK_DB = -1.5  # never exceeded; the overall gain is lowered instead of limiting
+
+
+def db(x):
+    return 20 * np.log10(max(float(x), 1e-9))
+
+
+def norm(word):
+    return re.sub(r"[^a-z0-9]", "", word.lower())
+
+
+def merge(words):
+    """Fold the spellings a transcriber may use for AI / M2 into one token."""
+    out = []
+    for w in words:
+        if out and out[-1]["w"] == "a" and w["w"] == "i":
+            out[-1] = {**out[-1], "w": "ai", "end": w.get("end")}
+        elif out and out[-1]["w"] == "m" and w["w"] in ("two", "2", "to", "too"):
+            out[-1] = {**out[-1], "w": "m2", "end": w.get("end")}
+        elif out and out[-1]["w"] == "harder" and w["w"] in ("set", "sets"):
+            out[-1]["w"], w = "hard", {**w, "w": "assets"}  # same sounds as "hard assets"
+            out.append(w)
+        elif w["w"]:
+            out.append(w)
+    return out
+
+
+def script_words(blocks):
+    """Expected words in spoken order; `lead` marks words of a discarded lead or tail."""
+    out = []
+    for i, block in enumerate(blocks):
+        for lead, source in ((True, block.get("lead", "")), (False, block["text"]), (True, block.get("tail", ""))):
+            out += merge([{"w": norm(raw), "block": i, "lead": lead}
+                          for raw in re.split(r"[\s\-]+", re.sub(r"<\w+>", " ", source))])
+    return out
+
+
+def take_text(blocks):
+    return " ".join(" ".join(b[k] for k in ("lead", "say", "tail") if b.get(k)) for b in blocks)
+
+
+def generate(llm, snac, text, seed):
+    llm.reset()  # no prompt-prefix reuse from the previous take, so a seed always gives the same take
+    codes, hit_eos = g.generate_codes(llm, VOICE, text, seed, max_tokens=MAX_TOKENS,
+                                      temperature=TEMPERATURE)
+    return g.decode_codes(snac, codes), hit_eos
+
+
+def load_whisper():
+    from faster_whisper import WhisperModel
+
+    return WhisperModel(os.environ.get("WHISPER_MODEL", "large-v3-turbo"), device="cuda",
+                        compute_type="float16")
+
+
+def transcribe(whisper, audio):
+    """Word timestamps. Audio goes in as a 16 kHz array (no file decoding in whisper)."""
+    pcm = subprocess.run(["ffmpeg", "-v", "error", "-f", "f32le", "-ar", str(RATE), "-ac", "1",
+                          "-i", "-", "-f", "f32le", "-ar", "16000", "-ac", "1", "-"],
+                         input=audio.astype(np.float32).tobytes(), capture_output=True, check=True)
+    segments, _ = whisper.transcribe(np.frombuffer(pcm.stdout, dtype=np.float32), language="en",
+                                     word_timestamps=True, beam_size=5, temperature=0.0,
+                                     condition_on_previous_text=False)
+    words = []
+    for seg in segments:
+        for w in seg.words:
+            for part in re.split(r"[\s\-]+", w.word.strip()):
+                words.append({"w": norm(part), "start": w.start, "end": w.end})
+    return merge(words)
+
+
+def align(blocks, heard):
+    """Map caption words to heard words. Returns (per-block word times, problems).
+
+    Only caption words are checked; lead words are discarded audio and may be heard as anything.
+    """
+    want = script_words(blocks)
+    vocab = {w["w"] for w in want}
+    for h in heard:  # a near-miss spelling of a script word (force/forced, Groman's) is that word
+        close = difflib.get_close_matches(h["w"], vocab, n=1, cutoff=0.75)
+        if h["w"] not in vocab and close:
+            h["w"] = close[0]
+    matcher = difflib.SequenceMatcher(None, [w["w"] for w in want], [w["w"] for w in heard],
+                                      autojunk=False)
+    hit, problems = {}, []
+    for tag, a0, a1, b0, b1 in matcher.get_opcodes():
+        if tag == "equal" or (tag == "replace" and a1 - a0 == b1 - b0):
+            for k in range(a1 - a0):
+                a, b = want[a0 + k], heard[b0 + k]["w"]
+                hit[a0 + k] = b0 + k  # same position, so its timing is usable either way
+                if not a["lead"] and difflib.SequenceMatcher(None, a["w"], b).ratio() < 0.6:
+                    problems.append(f"'{a['w']}' heard as '{b}'")
+            continue
+        missing = " ".join(w["w"] for w in want[a0:a1] if not w["lead"])
+        extra = " ".join(w["w"] for w in heard[b0:b1])
+        near_lead = any(w["lead"] for w in want[max(a0 - 1, 0): a1 + 1])
+        if missing:
+            problems.append(f"missing '{missing}'" + (f" (heard '{extra}')" if extra else ""))
+        elif extra and not near_lead:
+            problems.append(f"extra '{extra}'")
+    spans = []
+    for i, block in enumerate(blocks):
+        idx = [k for k, w in enumerate(want) if w["block"] == i and not w["lead"]]
+        if idx[0] not in hit or idx[-1] not in hit:
+            problems.append(f"{block['cue']}: first/last word not located")
+            spans.append(None)
+        else:
+            first, last = hit[idx[0]], hit[idx[-1]]
+            spans.append({"start": heard[first]["start"], "end": heard[last]["end"],
+                          "before": heard[first - 1]["end"] if first else 0.0,
+                          "after": heard[last + 1]["start"] if last + 1 < len(heard) else None})
+    return spans, problems
+
+
+def frame_rms(audio):
+    n = len(audio) // HOP
+    return np.sqrt(np.mean(audio[: n * HOP].reshape(n, HOP) ** 2, axis=1) + 1e-12)
+
+
+def silences(loud, lo, hi):
+    """Runs of at least MIN_SILENCE quiet frames inside [lo, hi]."""
+    runs, start = [], None
+    for f in range(lo, hi + 2):
+        quiet = f <= hi and not loud[f]
+        if quiet and start is None:
+            start = f
+        elif not quiet and start is not None:
+            if f - start >= MIN_SILENCE:
+                runs.append((start, f - 1))
+            start = None
+    return runs
+
+
+def find_cuts(audio, blocks, spans):
+    """Per block: the kept segment [seg_start, seg_end) and the speech onset/offset inside it.
+
+    A segment boundary always sits in the middle of a silence. Two adjacent blocks share the
+    longest silence between them. A lead is cut off at the last silence between its final word
+    and the block's first word; a tail (or the next block's lead) at the first silence after
+    the block's last word.
+    """
+    rms = frame_rms(audio)
+    loud = rms > max(np.percentile(rms, 5) * 4, np.percentile(rms, 95) * 10 ** (-40 / 20))
+    end_s = len(rms) / 100
+    problems = []
+
+    def cut(lo_s, hi_s, pick, what):
+        runs = silences(loud, max(int(lo_s * 100), 0), min(int(hi_s * 100), len(rms) - 1))
+        if not runs:
+            problems.append(f"no clean silence {what}")
+            return None
+        return sum(pick(runs)) // 2 + 1
+
+    def longest(runs):
+        return max(runs, key=lambda r: r[1] - r[0])
+
+    found = []
+    for k, (block, span) in enumerate(zip(blocks, spans)):
+        cue, last = block["cue"], k == len(blocks) - 1
+        # where the segment starts
+        if block.get("lead"):
+            start = cut(span["before"] - 0.1, span["start"] + 0.08, lambda r: r[-1], f"between {cue} and its lead")
+        elif k:
+            start = cut(spans[k - 1]["end"] - 0.08, span["start"] + 0.08, longest, f"before {cue}")
+        else:
+            start = 0
+        # where it ends
+        follows = block.get("tail") or (not last and blocks[k + 1].get("lead"))
+        if follows:
+            after = span["after"] if span["after"] is not None else end_s
+            end = cut(span["end"] - 0.08, after + 0.1, lambda r: r[0], f"after {cue}")
+        elif not last:
+            end = cut(span["end"] - 0.08, spans[k + 1]["start"] + 0.08, longest, f"after {cue}")
+        else:
+            end = len(rms)
+        if start is None or end is None or not loud[start:end].any():
+            start, end = int(span["start"] * 100), int(span["end"] * 100)  # flagged above; keep going
+        on = np.flatnonzero(loud[start:end])
+        if k == 0 and not block.get("lead"):  # drop silence before the first word
+            shift = max(int(on[0]) - 1, 0)
+            start, on = start + shift, on - shift
+        if last and not follows:  # and after the last
+            end = min(start + int(on[-1]) + 6, len(rms))
+        found.append({"audio": audio, "seg_start": start * HOP, "seg_end": end * HOP,
+                      "on": (start + int(on[0])) * HOP, "off": (start + int(on[-1]) + 1) * HOP})
+    return found, problems
+
+
+def pitch_hz(seg):
+    """Median autocorrelation pitch over voiced 40 ms frames (rough, for comparison only)."""
+    size, out = RATE // 25, []
+    for i in range(0, len(seg) - size, size // 2):
+        x = seg[i: i + size] * np.hanning(size)
+        ac = np.fft.irfft(np.abs(np.fft.rfft(x, 2 * size)) ** 2)[:size]
+        if ac[0] <= 0:
+            continue
+        lo, hi = RATE // 500, RATE // 70
+        lag = lo + int(np.argmax(ac[lo:hi]))
+        if ac[lag] / ac[0] > 0.45:
+            out.append(RATE / lag)
+    return float(np.median(out)) if out else 0.0
+
+
+def measure(audio, on, off):
+    seg = audio[on:off]
+    return {"rms_db": round(db(np.sqrt(np.mean(seg ** 2))), 1),
+            "peak_db": round(db(np.abs(seg).max()), 1), "pitch_hz": round(pitch_hz(seg))}
+
+
+def assemble(blocks, found):
+    """Keep each block's segment; pad every pause with silence up to gapAfter."""
+    fade_out = np.linspace(1, 0, FADE, dtype=np.float32)
+    parts, timeline, notes, pos = [], [], [], 0
+    for k, (block, f) in enumerate(zip(blocks, found)):
+        last = k == len(found) - 1
+        piece = f["audio"][f["seg_start"]: f["seg_end"]].copy()
+        piece[:FADE] *= fade_out[::-1]
+        piece[-FADE:] *= fade_out
+        timeline.append({"cue": block["cue"], "text": block["text"], "gapAfter": block["gapAfter"],
+                         "start": (pos + f["on"] - f["seg_start"]) / RATE,
+                         "end": (pos + f["off"] - f["seg_start"]) / RATE})
+        natural = f["seg_end"] - f["off"] + (0 if last else found[k + 1]["on"] - found[k + 1]["seg_start"])
+        add = max(int(block["gapAfter"] * RATE) - natural, 0)
+        parts += [piece, np.zeros(add, dtype=np.float32)]
+        pos += len(piece) + add
+        if not last:
+            nxt = found[k + 1]
+            notes.append({"after": block["cue"], "take": f["take"],
+                          "cut_at_take_s": round(f["seg_end"] / RATE, 2),
+                          "next_take": nxt["take"], "resume_at_take_s": round(nxt["seg_start"] / RATE, 2),
+                          "kept_silence_s": round(natural / RATE, 2),
+                          "inserted_silence_s": round(add / RATE, 2)})
+    return np.concatenate(parts), timeline, notes
+
+
+def master(audio, timeline):
+    """One static gain per block, rising over the film: no compression inside a block."""
+    out = audio.copy()
+    edges = [0] + [int((a["end"] + b["start"]) / 2 * RATE) for a, b in zip(timeline, timeline[1:])] + [len(out)]
+    gains = []
+    for k, b in enumerate(timeline):
+        rms = np.sqrt(np.mean(out[int(b["start"] * RATE): int(b["end"] * RATE)] ** 2))
+        target = TARGET_RMS_DB + RAMP_DB * (1 - k / (len(timeline) - 1))
+        gains.append(10 ** (target / 20) / rms)
+        out[edges[k]: edges[k + 1]] *= gains[-1]
+    guard = min(1.0, 10 ** (PEAK_DB / 20) / np.abs(out).max())
+    return (out * guard).astype(np.float32), [round(db(x * guard), 2) for x in gains]
+
+
+def analyse(whisper, blocks, audio, hit_eos=True):
+    heard = transcribe(whisper, audio)
+    spans, problems = align(blocks, heard)
+    if not hit_eos:
+        problems.insert(0, "no end-of-speech token")
+    found = None
+    if all(spans):
+        found, cut_problems = find_cuts(audio, blocks, spans)
+        problems += cut_problems
+    return {"heard": " ".join(w["w"] for w in heard), "problems": problems, "found": found}
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--audition", help="seed range A-B: generate each into narration/takes/ and report")
+    ap.add_argument("--only", type=int, help="with --audition: just this take (index into `takes`)")
+    ap.add_argument("--cached", action="store_true", help="reuse narration/takes/<i>/seed-<n>.wav")
+    ap.add_argument("--script", default=str(OUT / "script.json"))
+    a = ap.parse_args()
+
+    clip = json.loads(Path(a.script).read_text())["clips"][0]
+    blocks = clip["blocks"]
+    by_cue = {b["cue"]: b for b in blocks}
+    takes = [{**t, "blocks": [by_cue[c] for c in t["cues"]]} for t in clip["takes"]]
+    assert [c for t in takes for c in t["cues"]] == [b["cue"] for b in blocks], "takes must cover blocks in order"
+    cache = Path(os.environ.get("TAKES_DIR", OUT / "takes"))
+    whisper = load_whisper()
+    llm = snac = None
+    if not a.cached:
+        llm, snac = g.load_llm(n_ctx=N_CTX), g.load_snac()
+
+    if a.audition:
+        lo, hi = map(int, a.audition.split("-"))
+        for i, take in enumerate(takes):
+            if a.only is not None and i != a.only:
+                continue
+            (cache / str(i)).mkdir(parents=True, exist_ok=True)
+            report = []
+            for seed in range(lo, hi + 1):
+                audio, hit_eos = generate(llm, snac, take_text(take["blocks"]), seed)
+                sf.write(cache / str(i) / f"seed-{seed}.wav", audio, RATE, subtype="PCM_16")
+                r = analyse(whisper, take["blocks"], audio, hit_eos)
+                row = {"take": i, "seed": seed, "seconds": round(len(audio) / RATE, 2),
+                       "problems": r["problems"], "heard": r["heard"]}
+                if r["found"]:
+                    row["blocks"] = [{"cue": b["cue"], "on": round(f["on"] / RATE, 2),
+                                      "off": round(f["off"] / RATE, 2), **measure(audio, f["on"], f["off"])}
+                                     for b, f in zip(take["blocks"], r["found"])]
+                report.append(row)
+                print(json.dumps({k: v for k, v in row.items() if k != "blocks"}), flush=True)
+            (cache / str(i) / "audition.json").write_text(json.dumps(report, indent=2))
+        return
+
+    found, log = [], []
+    for i, take in enumerate(takes):
+        path = cache / str(i) / f"seed-{take['seed']}.wav"
+        if a.cached:
+            audio, hit_eos = sf.read(path, dtype="float32")[0], True
+        else:
+            audio, hit_eos = generate(llm, snac, take_text(take["blocks"]), take["seed"])
+        r = analyse(whisper, take["blocks"], audio, hit_eos)
+        if r["found"] is None:
+            sys.exit(f"take {i} unusable: {r['problems']}\nheard: {r['heard']}")
+        for p in r["problems"]:
+            print(f"WARNING: take {i}:", p, file=sys.stderr)
+        found += [{**f, "take": i} for f in r["found"]]
+        log.append({"take": i, "seed": take["seed"], "seconds": round(len(audio) / RATE, 2),
+                    "spoken": take_text(take["blocks"]), "heard": r["heard"], "problems": r["problems"]})
+    padded, timeline, notes = assemble(blocks, found)
+    final, gains = master(padded, timeline)
+
+    wav = OUT / f'{clip["id"]}.wav'
+    sf.write(wav, final, RATE, subtype="PCM_16")
+    subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", str(wav), "-c:a", "aac", "-b:a", "160k",
+                    str(OUT / f'{clip["id"]}.m4a')], check=True)
+    (OUT / "timeline.json").write_text(json.dumps(
+        [{"id": clip["id"], "title": clip["title"], "duration": len(final) / RATE, "blocks": timeline}],
