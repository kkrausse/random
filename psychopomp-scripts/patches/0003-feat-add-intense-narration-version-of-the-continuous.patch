+"""Deliver the intense-narration version next to the continuous one, replacing neither."""
+import html
+import json
+import pathlib
+import shutil
+import subprocess
+import zipfile
+
+HERE = pathlib.Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+SHARED = HERE.parent / "gromen-continuous"
+OUT = ROOT / "output/gromen-intense-public"
+OUT.mkdir(parents=True, exist_ok=True)
+revision = "afce680"
+script = json.loads((HERE / "narration/script.json").read_text())
+clip = json.loads((HERE / "narration/timeline.json").read_text())[0]
+raw = ROOT / "output/raw.mp4"
+# No loudnorm here: the narration is mixed to get louder toward the end, and
+# dynamic normalization would level that back out.
+subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", str(raw), "-c:v", "copy", "-ar", "48000",
+                "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart", str(OUT / "bondfire.mp4")],
+               check=True)
+crisis = next(b for b in clip["blocks"] if b["cue"] == "crisis")
+subprocess.run(["ffmpeg", "-y", "-v", "error", "-ss", f"{crisis['end'] + 3:.2f}", "-i", str(raw),
+                "-frames:v", "1", str(OUT / "poster.png")], check=True)
+shutil.copy2(HERE / "captions.vtt", OUT / "captions.vtt")
+shutil.copy2(HERE / "narration/script.json", OUT / "script.json")
+blocks = script["clips"][0]["blocks"]
+text = " ".join(block["text"] for block in blocks)
+spoken = " ".join(block["say"] for block in blocks)
+page = """<!doctype html><html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1"><link rel="icon" href="data:,">
+<title>The Bondfire / One System (intense narration)</title>
+<style>:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#090d14;color:#edf1fa}*{box-sizing:border-box}body{margin:0}main{max-width:1200px;margin:auto;padding:32px 24px 70px}a{color:#afd6ff;text-underline-offset:4px}nav{display:flex;gap:24px;font-size:14px;margin-bottom:38px;flex-wrap:wrap}.tag{color:#efbe77;font:12px monospace;letter-spacing:.15em}h1{font-size:clamp(40px,7vw,76px);letter-spacing:-.05em;line-height:1.05;margin:14px 0}.sub{color:#b5c3d7;font-size:18px;line-height:1.6;margin-bottom:28px}video{display:block;width:100%;border:1px solid #364252;border-radius:12px;background:#03070c}.links{display:flex;gap:12px;flex-wrap:wrap;margin:22px 0 30px}.links a{padding:10px 15px;border:1px solid #364252;background:#152031;border-radius:8px;text-decoration:none}details{margin-top:20px;border-top:1px solid #364252;padding:18px 0}summary{cursor:pointer;font-size:17px}p,li{line-height:1.7;color:#bcc8da}footer{color:#8999ae;font:12px monospace;margin-top:35px}@media(max-width:600px){main{padding:22px 14px}nav{margin-bottom:30px}.sub{font-size:16px}.links a{font-size:13px}}</style>
+</head><body><main><nav><a href="/artifacts/">All artifacts</a><a href="../gromen-bondfire-continuous-20261005/">Calm narration version</a><a href="../gromen-bondfire-20261005/">Original explainer</a></nav>
+<div class="tag">ONE DIAGRAM · NO CUTS · INTENSE NARRATION</div><h1>The Bondfire.<br>One system.</h1>
+<p class="sub">The same film, re-voiced. The narrator starts level and ends up shouting.</p>
+<video controls playsinline preload="metadata" poster="poster.png"><source src="bondfire.mp4" type="video/mp4"><track src="captions.vtt" kind="captions" srclang="en" label="English"></video>
+<div class="links"><a href="bondfire.mp4" download>Download MP4</a><a href="source.zip" download>Animation source</a><a href="../gromen-bondfire-20261005/causal-map.svg" target="_blank" rel="noopener">Detailed causal map ↗</a></div>
+<details><summary>Script & caveat</summary><p>__TEXT__</p><p>A visual dramatization of Luke Gromen's October 2, 2026 thesis, not a verified forecast. Grouping is a visual abstraction: these actors are not literally the same balance sheet. Supply shocks do not mechanically raise real yields; liquidity support does not automatically cause M2 growth or dollar debasement. The ending is disputed. The narrator's rising volume is a performance choice, not a claim about how likely any of this is.</p><p><a href="script.json">Script JSON</a> · <a href="captions.vtt">Captions</a> · <a href="../gromen-bondfire-20261005/#transcript">Long version and sources</a></p></details>
+<details><summary>How it was made</summary><p>Same Psychopomp Scene Plan and choreography as the <a href="../gromen-bondfire-continuous-20261005/">calm version</a>, retimed to a new narration track. The voice is Orpheus 3B (voice "dan"), an open speech model run locally. It has no emotion or volume setting, so the build comes from how the lines are written for it:</p><p><em>__SPOKEN__</em></p><p>The later lines were generated with extra shouted sentences before and after them to push the delivery, and those extras were cut out. Each line's start and end were found by transcribing the audio, and the animation and captions follow those times.</p><p>1920×1080 at 60 fps, temporal motion blur. Built with <a href="https://github.com/kitlangton/psychopomp">Psychopomp</a>.</p></details>
+<footer>GROMEN'S SCENARIO / NOT A FORECAST · PUBLIC ARTIFACT ON THE RASPBERRY PI</footer>
+</main></body></html>"""
+(OUT / "index.html").write_text(page.replace("__TEXT__", html.escape(text))
+                                .replace("__SPOKEN__", html.escape(spoken)))
+reproduce = f"""#!/usr/bin/env bash
+# Rebuilds the film from the bundled narration audio; no speech model needed.
+set -euo pipefail
+HERE="$(cd -- "$(dirname -- "${{BASH_SOURCE[0]}}")" && pwd)"
+DEST="${{1:-$HERE/psychopomp-build}}"
+git clone https://github.com/kitlangton/psychopomp.git "$DEST"
+git -C "$DEST" checkout --detach {revision}
+mkdir -p "$DEST/scenes/gromen-intense" "$DEST/scenes/gromen-continuous"
+cp -a "$HERE/scene/." "$DEST/scenes/gromen-intense/"
+cp -a "$HERE/continuous/." "$DEST/scenes/gromen-continuous/"
+cd "$DEST"
+cargo run -p psychopomp-gromen-intense
+mkdir -p output
+cargo run --release -- plan render scenes/gromen-intense/continuous.json output/raw.mp4 --theme neutral
+ffmpeg -y -i output/raw.mp4 -c:v copy -ar 48000 -c:a aac -b:a 192k -movflags +faststart output/bondfire.mp4
+"""
+(OUT / "reproduce.sh").write_text(reproduce)
+with zipfile.ZipFile(OUT / "source.zip", "w", zipfile.ZIP_DEFLATED) as bundle:
+    bundle.writestr("reproduce.sh", reproduce)
+    bundle.write(ROOT / "LICENSE", "LICENSE")
+    for name in ["Cargo.toml", "src/main.rs", "voice.py", "package.py", "narration/script.json",
+                 "narration/timeline.json", "narration/continuous.m4a"]:
+        bundle.write(HERE / name, "scene/" + name)
+    for name in ["Cargo.toml", "src/main.rs"]:
+        bundle.write(SHARED / name, "continuous/" + name)
+print(f"{OUT}: {clip['duration']+5:.1f}s, 1 scene")
