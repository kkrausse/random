+
+type Edge<'a> = (&'a str, &'a str, &'a str, &'a str);
+type ChapterLayout<'a> = (Vec<Value>, Vec<Edge<'a>>, Vec<&'a str>);
+
+#[derive(Deserialize)]
+struct Block {
+    cue: String,
+    text: String,
+    start: f64,
+    end: f64,
+}
+#[derive(Deserialize)]
+struct Clip {
+    id: String,
+    title: String,
+    duration: f64,
+    blocks: Vec<Block>,
+}
+impl Clip {
+    fn at(&self, cue: &str) -> u64 {
+        seconds(1.0 + self.blocks.iter().find(|b| b.cue == cue).unwrap().start)
+    }
+    fn end(&self, cue: &str) -> u64 {
+        seconds(1.0 + self.blocks.iter().find(|b| b.cue == cue).unwrap().end)
+    }
+}
+
+fn card(id: &str, x: f32, y: f32, title: &str, detail: &str, tone: &str) -> Value {
+    json!({"kind":"card","id":id,"at":[x,y,0],"size":[370,126],
+           "title":title,"tone":tone,"status":[{"text":detail,"tone":"muted"}]})
+}
+fn label(id: &str, x: f32, y: f32, text: &str, size: f32, tone: &str) -> Value {
+    json!({"kind":"label","id":id,"at":[x,y,-1],"size":size,
+           "spans":[{"text":text,"tone":tone}]})
+}
+fn orb(id: &str, x: f32, y: f32, tone: &str) -> Value {
+    json!({"kind":"orb","id":id,"at":[x,y,0],"radius":135,"points":520,"tone":tone})
+}
+fn wire(id: &str, from: &str, to: &str, tone: &str) -> [Value; 2] {
+    [
+        json!({"kind":"path","id":id,"through":[from,to],"arrow":"end","tone":tone}),
+        json!({"kind":"packet","id":format!("p-{id}"),"beam":id,"tone":tone}),
+    ]
+}
+fn stage_plan(nodes: Vec<Value>, edges: &[(&str, &str, &str, &str)]) -> Result<StagePlan> {
+    let elements = nodes
+        .into_iter()
+        .chain(edges.iter().flat_map(|&(id, a, b, t)| wire(id, a, b, t)))
+        .collect::<Vec<_>>();
+    let mut plan: StagePlan = serde_json::from_value(json!({"elements":elements}))?;
+    plan.post = StagePost::RESTRAINED;
+    Ok(plan)
+}
+
+fn caption(
+    scene: &mut PlanBuilder,
+    id: &str,
+    text: &str,
+    pos: [f32; 2],
+    size: f32,
+    tone: Tone,
+) -> Result<Caption> {
+    Caption::declare(
+        scene,
+        id,
+        &CaptionPlan::line(pos, size, vec![CaptionSpanPlan::new(text, tone)]),
+    )
+}
+
+fn base(clip: &Clip, plan: &StagePlan, footers: &[&str]) -> Result<(PlanBuilder, Stage)> {
+    let mut scene = PlanBuilder::new(&clip.id, seconds(clip.duration + 3.5));
+    scene.media(MediaPlan {
+        id: format!("voice-{}", clip.id),
+        path: PathBuf::from(format!("narration/{}.m4a", clip.id)),
+        kind: MediaKindPlan::Audio,
+        role: MediaRolePlan::Script,
+        source_start_nanos: 0,
+        source_end_nanos: seconds(clip.duration),
+        timeline_start_nanos: seconds(1.0),
+        timeline_end_nanos: seconds(clip.duration + 1.0),
+        gain_db: 0.0,
+    });
+    let s = Stage::declare(&mut scene, "stage", plan)?;
+    let header = caption(
+        &mut scene,
+        "header",
+        &clip.title,
+        [88.0, 75.0],
+        36.0,
+        Tone::Plain,
+    )?;
+    scene.at(seconds(0.15), header.type_in(90.0, 0.2));
+    let tag = caption(
+        &mut scene,
+        "scenario",
+        "GROMEN'S SCENARIO / NOT A FORECAST",
+        [88.0, 128.0],
+        20.0,
+        Tone::Warning,
+    )?;
+    scene.at(seconds(0.3), tag.show());
+    for (i, block) in clip.blocks.iter().enumerate() {
+        let note = caption(
+            &mut scene,
+            &format!("footer-{i}"),
+            footers[i],
+            [88.0, 990.0],
+            27.0,
+            Tone::Plain,
+        )?;
+        scene.at(seconds(1.0 + block.start), note.show());
+        let hide = if i + 1 < clip.blocks.len() {
+            1.0 + clip.blocks[i + 1].start - 0.2
+        } else {
+            clip.duration + 3.1
+        };
+        scene.at(seconds(hide), note.hide());
+    }
+    for (i, el) in plan.elements.iter().enumerate() {
+        let id = el.id();
+        match el {
+            StageElement::Card { .. } => {
+                scene.at(seconds(0.25 + (i as f64) * 0.11), s.settle_in(id));
+            }
+            StageElement::Label { .. } | StageElement::Orb { .. } => {
+                if clip.id == "rescue" && ["release", "hard", "stocks"].contains(&id) {
+                    scene.at(0, s.channel(format!("{id}.opacity"), 0.0));
+                } else {
+                    scene.at(seconds(0.4), s.fade_in(id, 1.0, 0.6));
+                }
+            }
+            StageElement::Path { .. } => {
+                scene.at(0, s.channel(format!("{id}.draw"), 0.0));
+            }
+            _ => {}
+        }
+    }
+    Ok((scene, s))
+}
+fn send(scene: &mut PlanBuilder, s: &Stage, clip: &Clip, cue: &str, edge: &str, to: &str) {
+    scene.at(
+        clip.at(cue),
+        s.connect(edge, 0.5)
+            .then(s.send(format!("p-{edge}"), 0.75))
+            .with(sfx::SEND.beat(format!("sound-{edge}-{cue}"), -18.0))
+            .then(s.land(to)),
+    );
+}
