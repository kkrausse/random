index 0000000..03356f1
--- /dev/null
+++ b/scenes/gromen/README.md
@@ -0,0 +1,25 @@
+# The Bondfire
+
+A nine-chapter, sentence-cued Psychopomp film of the supplied October 2, 2026
+FFTT Tree Rings thesis, with explicit attribution and contested causal links.
+
+- `src/main.rs`: animated causal diagrams, packets, score choreography and explosion.
+- `narration/script.json`: spoken script; claims are scenario-attributed.
+- `narration/timeline.json`: exact generated sentence spans.
+- `narration/*.m4a`: local Piper Lessac narration; not Gromen's voice.
+- `map.dot`: full causal map, including contextual actors and policy off-ramps.
+- `voice.py`: optional local re-voicing (requires piper-tts and the Lessac model).
+- `package.py`: public mobile-readable artifact and downloadable source bundle.
+
+Run `cargo run -p psychopomp-gromen`, then validate and render the emitted reel.
+The public source bundle has a pinned-upstream reproduction script. No TTS service
+or model is needed to re-render the included narration. Audio delivery uses
+FFmpeg loudness normalization and MP4 fast-start remuxing.
+
+Checked: all workspace tests, formatting and strict Clippy; unchanged upstream
+hello/camera/stage-forms snapshots; deterministic repeated chapter snapshots;
+nine chapter frames and a six-second, 60fps explosion study; mobile page layout.
+
+Do not reinterpret the M2 graph as an automatic reserves-to-inflation chain.
+The 2% real-rate and MOVE 120–130 levels are the thesis's warning/watch zones,
+not established universal triggers. The full original report is not distributed.
diff --git a/scenes/gromen/map.dot b/scenes/gromen/map.dot
new file mode 100644
index 0000000..d1bc724
--- /dev/null
+++ b/scenes/gromen/map.dot
@@ -0,0 +1,129 @@
+digraph Bondfire {
+  graph [rankdir=TB, newrank=true, bgcolor="#0b1019", pad=0.45, nodesep=0.38, ranksep=0.75,
+    fontname="DejaVu Sans", fontcolor="#e8edf7", fontsize=24,
+    label="THE BONDFIRE\nLuke Gromen's October 2, 2026 scenario — conditional, not a forecast", labelloc=t];
+  node [shape=box, style="rounded,filled", fillcolor="#182332", color="#4a5e74",
+    fontname="DejaVu Sans", fontcolor="#eef2fa", fontsize=15, margin="0.20,0.13"];
+  edge [color="#9dabbc", fontcolor="#bfccdb", fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
+
+  subgraph cluster_fiscal {
+    label="1 / FISCAL COMMITMENTS"; color="#745f36"; fontcolor="#f6cf80";
+    retirees [label="Boomers + other retirees\nSocial Security / Medicare"];
+    veterans [label="Veterans\nlong-lived benefit commitments"];
+    congress [label="Congress\ntaxes + spending + fiscal law"];
+    commitments [label="Persistent primary deficits\nspending exceeds receipts",color="#cfa451"];
+    treasury [label="Treasury / Bessent\nbills, bonds, cash management"];
+    retirees -> commitments [label="aging / benefits"];
+    veterans -> commitments [label="benefit costs"];
+    congress -> commitments [label="Gromen assumes insufficient adjustment"];
+    commitments -> treasury [label="financing need"];
+  }
+  subgraph cluster_external {
+    label="2 / EXTERNAL PRESSURE"; color="#674344"; fontcolor="#f4a6a5";
+    iran [label="Iran / Hormuz\noil supply disruptions"];
+    refiners [label="Chinese refiners\nfuel export restrictions"];
+    chile [label="Chile / copper miners\nsupply disruption"];
+    commodities [label="Expensive oil + constrained copper\nreal supply bottlenecks"];
+    inflation [label="Inflation pressure"];
+    fedpolicy [label="Fed / Warsh\ntight interest-rate policy"];
+    iran -> commodities [label="oil pressure"];
+    refiners -> commodities [label="fuel pressure"];
+    chile -> commodities [label="copper pressure"];
+    commodities -> inflation;
+    inflation -> fedpolicy [label="assumed policy response"];
+  }
+  subgraph cluster_flows {
+    label="3 / GLOBAL CAPITAL"; color="#355675"; fontcolor="#a0caff";
+    foreign [label="Foreign investors\nchoose between U.S. and other assets"];
+    china [label="China / East Asian surpluses"];
+    other [label="Gold / commodities / non-U.S. lending\nGromen's interpretation of missing flows"];
+    demand [label="Less reliable Treasury demand"];
+    domestic [label="Domestic buyers\nfunds, pensions, households, banks"];
+    china -> other [label="alternative surplus recycling"];
+    foreign -> demand [label="less allocation to USTs"];
+    china -> demand [label="less recycling into USTs"];
+    domestic -> demand [label="can offset foreign weakness",color="#85c9ae"];
+  }
+
+  yields [label="HIGHER TREASURY YIELDS\nnew borrowing / refinancing cost",color="#ed8d7b",penwidth=2];
+  interest [label="Higher effective interest expense\nas old debt matures",color="#ed8d7b"];
+  deficit [label="Larger total deficits",color="#ed8d7b"];
+  issuance [label="More Treasury issuance",color="#ed8d7b"];
+  growth [label="Weaker growth / asset prices\nlower tax receipts",color="#d8b56c"];
+  dollar [label="Initially stronger dollar"];
+  debtors [label="Foreign USD debtors\nfunding squeeze / sell assets"];
+  fedpolicy -> yields [label="Gromen's rate / fiscal channel"];
+  demand -> yields [label="price must attract marginal buyers"];
+  treasury -> issuance;
+  yields -> interest [label="ROLLOVER",color="#ff9c8d",penwidth=2];
+  interest -> deficit [label="COST",color="#ff9c8d",penwidth=2];
+  deficit -> issuance [label="FINANCING",color="#ff9c8d",penwidth=2];
+  issuance -> yields [label="SUPPLY / DEMAND",color="#ff9c8d",penwidth=2,constraint=false];
+  fedpolicy -> growth [label="tight financial conditions"];
+  growth -> deficit [label="weaker receipts"];
+  fedpolicy -> dollar [label="conditional, not guaranteed"];
+  dollar -> debtors;
+  debtors -> yields [label="possible UST selling"];
+
+  subgraph cluster_credit {
+    label="4 / CREDIT ACCELERANTS"; color="#644b75"; fontcolor="#dbb3fa";
+    ai [label="AI hyperscalers\nchips + data centers + power capex"];
+    techdebt [label="Corporate / off-balance-sheet borrowing"];
+    workers [label="Workers / consumers\nAI displacement in adverse branch"];
+    credit [label="Consumer delinquencies\nprivate-credit / refinancing losses"];
+    banks [label="Banks / insurers / pension funds\ncredit and bond-price exposures"];
+    funds [label="Leveraged Treasury funds / dealers\nrepo + basis-trade financing"];
+    ai -> techdebt;
+    techdebt -> yields [label="capital competition / crowding out"];
+    ai -> workers [label="adverse employment scenario"];
+    workers -> credit;
+    workers -> growth [label="weaker consumption / tax base"];
+    credit -> banks;
+    yields -> banks [label="bond valuation losses"];
+    yields -> funds [label="margin / funding stress"];
+  }
+  crisis [label="TREASURY MARKET DYSFUNCTION\nforced selling / impaired collateral\nMOVE 120–130: Gromen's watch zone, not an official trigger",
+    fillcolor="#542429", color="#ff8877",penwidth=3];
+  banks -> crisis;
+  funds -> crisis;
+  crisis -> funds [label="feedback: margin / liquidation",color="#ff9c8d",constraint=false];
+  crisis -> banks [label="feedback: collateral losses",color="#ff9c8d",constraint=false];
+  riskoff [label="Initial risk-off\nUSD up; stocks / long bonds / hard assets can fall"];
+  crisis -> riskoff;
+
+  trump [label="Trump / political pressure\nGromen speculates crisis creates cover for inflation"];
+  choice [shape=diamond,label="POLICY FORK",fillcolor="#302b20",color="#e7bc65"];
+  crisis -> choice;
+  trump -> choice [style=dashed,label="interpretation, not established intent"];
+  failure [label="Stand aside\ndeeper market / economic damage"];
+  rescue [label="GROMEN'S BASE CASE\nFed / Treasury intervene despite inflation",color="#8bcae9",penwidth=2];
+  choice -> failure [label="alternative"];
+  choice -> rescue [label="predicted response"];
+  balance [label="Fed balance sheet\nrepo loans / purchased assets"];
+  reserves [label="Bank reserves\nFed liabilities held by banks"];
+  deposits [label="Public deposits / M2\nnot the same thing as bank reserves"];
+  fiscalpayments [label="Fiscal payments + bank credit\noperation-specific deposit effects"];
+  rescue -> balance;
+  balance -> reserves;
+  reserves -> deposits [style=dashed,label="NOT an automatic 1:1 causal link",color="#83b5df"];
+  treasury -> fiscalpayments [style=dashed,label="financing / spending mechanics"];
+  fiscalpayments -> deposits [label="depends on counterparties / operation"];
+  accommodate [label="CRUCIAL GROMEN ASSUMPTION\nsustained fiscal accommodation / negative real returns",
+    fillcolor="#343023",color="#e1bc6a",penwidth=2];
+  rescue -> accommodate [label="not implied by every liquidity facility"];
+  release [label="Dollar / purchasing power becomes release valve"];
+  hard [label="Gold / silver / BTC outperform\nGromen's predicted endpoint"];
+  equities [label="Stocks can rally in USD\nwhile falling measured in gold"];
+  power [label="Electrical-infrastructure equities\nGromen favors exposure; cost pass-through is not assured"];
+  accommodate -> release;
+  release -> hard;
+  release -> equities;
+  commodities -> power [label="capex demand / possible cost pass-through"];
+
+  alternatives [label="CONTESTED LINKS / OFF-RAMPS\nWang: liquidity support ≠ policy easing\nMainstream: phased tax + spending reform / productivity\nNo universal 2% real-rate threshold or inevitable crisis date",
+    fillcolor="#172f30",color="#82c9bc",penwidth=2];
+  congress -> alternatives [style=dashed,color="#82c9bc",label="policy can change"];
+  alternatives -> commitments [style=dashed,color="#82c9bc",label="primary deficit improvement",constraint=false];
+  alternatives -> rescue [style=dashed,color="#82c9bc",label="market repair without fiscal debasement"];
+  {rank=same; retirees; veterans; congress; iran; refiners; chile; foreign; china; domestic; ai;}
+}
