+"""Local, reproducible narration; exact sentence-level cues, no paid API."""
+import io
+import json
+import pathlib
+import subprocess
+import wave
+from piper import PiperVoice, SynthesisConfig
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+HERE = pathlib.Path(__file__).resolve().parent
+OUT = HERE / "narration"
+script = json.loads((OUT / "script.json").read_text())
+voice = PiperVoice.load(str(ROOT / "assets/lessac.onnx"))
+config = SynthesisConfig(length_scale=1.05, noise_scale=0.5)
+timeline = []
+for clip in script["clips"]:
+    frames = bytearray()
+    blocks = []
+    rate = 22050
+    for block in clip["blocks"]:
+        buf = io.BytesIO()
+        with wave.open(buf, "wb") as wav:
+            voice.synthesize_wav(block["text"], wav, config)
+        buf.seek(0)
+        with wave.open(buf, "rb") as wav:
+            assert wav.getnchannels() == 1 and wav.getsampwidth() == 2
+            rate = wav.getframerate()
+            audio = wav.readframes(wav.getnframes())
+        start = len(frames) / (2 * rate)
+        frames.extend(audio)
+        end = len(frames) / (2 * rate)
+        blocks.append({**block, "start": start, "end": end})
+        frames.extend(b"\0\0" * int(rate * block.get("gapAfter", 0.3)))
+    path = OUT / f'{clip["id"]}.wav'
+    with wave.open(str(path), "wb") as wav:
+        wav.setparams((1, 2, rate, 0, "NONE", "not compressed"))
+        wav.writeframes(frames)
+    final = OUT / f'{clip["id"]}.m4a'
+    subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", str(path),
+                    "-af", "loudnorm=I=-16:TP=-1:LRA=9", "-c:a", "aac",
+                    "-b:a", "128k", str(final)], check=True)
+    timeline.append({"id": clip["id"], "title": clip["title"],
+                     "duration": len(frames) / (2 * rate), "blocks": blocks})
+    print(clip["id"], round(timeline[-1]["duration"], 2))
+(OUT / "timeline.json").write_text(json.dumps(timeline, indent=2))
