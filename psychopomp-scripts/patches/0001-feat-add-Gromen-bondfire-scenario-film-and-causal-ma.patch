+                ("copper", "m", "copper"),
+                ("fed", "f", "fed"),
+            ] {
+                send(&mut scene, &s, c, cue, e, to);
+            }
+            scene.at(
+                c.at("iran") + seconds(3.0),
+                s.connect("c", 0.5)
+                    .then(s.send("p-c", 0.7))
+                    .then(s.land("oil")),
+            );
+            scene.at(
+                c.at("fed") + seconds(2.7),
+                s.connect("p", 0.5)
+                    .then(s.send("p-p", 0.7))
+                    .then(s.land("fed")),
+            );
+        }
+        "spiral" => {
+            for (cue, e, to) in [
+                ("rates", "a", "interest"),
+                ("interest", "b", "deficit"),
+                ("deficit", "c", "issuance"),
+                ("issuance", "d", "yields"),
+                ("growth", "g", "deficit"),
+            ] {
+                send(&mut scene, &s, c, cue, e, to);
+            }
+            scene.at(c.at("growth"), s.charge("core", 0.65, 2.0));
+            scene.at(c.at("threshold"), s.charge("core", 0.0, 0.7));
+        }
+        "ai" => {
+            for (cue, e, to) in [
+                ("hyperscalers", "a", "treasury"),
+                ("workers", "w", "workers"),
+                ("credit", "c", "credit"),
+                ("collateral", "b", "banks"),
+            ] {
+                send(&mut scene, &s, c, cue, e, to);
+            }
+            scene.at(
+                c.at("collateral") + seconds(2.4),
+                s.connect("t", 0.5)
+                    .then(s.send("p-t", 0.75))
+                    .then(s.land("banks")),
+            );
+        }
+        "crisis" => {
+            send(&mut scene, &s, c, "riskoff", "a", "core");
+            send(&mut scene, &s, c, "move", "b", "core");
+            scene.at(c.at("move"), s.charge("core", 0.9, 2.0));
+            send(&mut scene, &s, c, "explosion", "h", "core");
+            let boom = c.end("explosion") + seconds(0.25);
+            scene.at(
+                boom.saturating_sub(sfx::RISER.length()),
+                sfx::RISER.beat("funding-pressure-riser", -21.0),
+            );
+            scene.at(
+                boom,
+                s.clock_for("core.burst", 5.2)
+                    .with(sfx::BOOM.beat("bondfire", -7.0)),
+            );
+            scene.at(boom + seconds(0.12), s.jolt([0.8, -0.2], 0.8));
+            for id in ["banks", "hedge", "assets"] {
+                scene.at(boom + seconds(0.5), s.hit(format!("{id}.damage"), 1.0, 0.4));
+            }
+            scene.at(c.at("choice"), s.charge("core", 0.0, 0.4));
+        }
+        "rescue" => {
+            for id in ["release", "hard", "stocks"] {
+                scene.at(0, s.set(format!("{id}.opacity"), 0.0));
+            }
+            for (cue, e, to) in [
+                ("reserves", "f", "reserves"),
+                ("reserves", "b", "banks"),
+                ("m2", "t", "fiscal"),
+                ("m2", "m", "m2"),
+            ] {
+                send(&mut scene, &s, c, cue, e, to);
+            }
+            scene.at(
+                c.at("m2") + seconds(3.0),
+                s.connect("credit", 0.5)
+                    .then(s.send("p-credit", 0.7))
+                    .then(s.land("m2")),
+            );
+            scene.at(c.at("debase"), s.fade_in("release", 1.0, 0.6));
+            scene.at(
+                c.at("assets"),
+                s.fade_in("hard", 1.0, 0.6)
+                    .with(sfx::BLOOM.beat("hard-assets", -16.0)),
+            );
+            scene.at(c.at("assets") + seconds(3.0), s.fade_in("stocks", 1.0, 0.6));
+        }
+        "dispute" => {
+            for (cue, id) in [
+                ("gromen", "gromen"),
+                ("wang", "wang"),
+                ("mainstream", "mainstream"),
+            ] {
+                scene.at(c.at(cue), s.land(id));
+            }
+        }
+        _ => {}
+    }
+    Ok(scene.finish()?)
+}
+
+fn main() -> Result<()> {
+    let here = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    let clips: Vec<Clip> =
+        serde_json::from_slice(&std::fs::read(here.join("narration/timeline.json"))?)?;
+    let plans = clips.iter().map(build).collect::<Result<Vec<_>>>()?;
+    for p in &plans {
+        p.write_or_print(Some(here.join(format!("{}.json", p.id))))?;
+    }
+    let reel = ReelPlan::dipped("the-bondfire", plans, seconds(0.5))?;
+    std::fs::write(
+        here.join("gromen.reel.json"),
+        serde_json::to_string_pretty(&reel)?,
+    )?;
+    // Exact sentence-level caption timing and chapter offsets, for accessible playback.
+    let mut offset = 0.0;
+    let mut vtt = String::from("WEBVTT\n\n");
+    let mut chapters = Vec::new();
+    let stamp = |t: f64| {
+        let ms = (t * 1000.0).round() as u64;
+        format!(
+            "{:02}:{:02}:{:02}.{:03}",
+            ms / 3600000,
+            ms / 60000 % 60,
+            ms / 1000 % 60,
+            ms % 1000
+        )
+    };
+    for c in &clips {
+        chapters.push(json!({"title":c.title,"start":offset,"duration":c.duration+3.5}));
+        for b in &c.blocks {
+            vtt += &format!(
+                "{} --> {}\n{}\n\n",
+                stamp(offset + 1.0 + b.start),
+                stamp(offset + 1.0 + b.end),
+                b.text
+            );
+        }
+        offset += c.duration + 3.0;
+    }
+    std::fs::write(here.join("captions.vtt"), vtt)?;
+    std::fs::write(
+        here.join("chapters.json"),
+        serde_json::to_string_pretty(&chapters)?,
+    )?;
+    println!(
+        "Wrote {} (about {:.1} seconds)",
+        here.join("gromen.reel.json").display(),
+        offset + 0.5
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn clips() -> Vec<Clip> {
+        serde_json::from_str(include_str!("../narration/timeline.json")).unwrap()
+    }
+
+    #[test]
+    fn sentence_cues_are_ordered_and_inside_audio() {
+        let clips = clips();
+        assert_eq!(clips.len(), 9);
+        for clip in clips {
+            let mut previous = 0.0;
+            let mut ids = std::collections::HashSet::new();
+            for block in &clip.blocks {
+                assert!(ids.insert(&block.cue));
+                assert!(block.start >= previous);
+                assert!(block.end > block.start);
+                assert!(block.end <= clip.duration);
+                previous = block.end;
+            }
+        }
+    }
+
+    #[test]
+    fn every_chapter_builds_a_valid_plan_with_narration() {
+        for clip in clips() {
+            let plan = build(&clip).unwrap();
+            assert!(
+                plan.media
+                    .iter()
+                    .any(|m| matches!(m.role, MediaRolePlan::Script))
+            );
+            assert_eq!(plan.id, clip.id);
+        }
+    }
+}
