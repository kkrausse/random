{
  "manifest_version": 3,
  "name": "Command Palette",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "A Spotlight-style command palette (Cmd+Shift+P) that teaches Chrome's keyboard shortcuts.",
  "key": "",
  "permissions": [
    "tabs",
    "sessions",
    "bookmarks",
    "history",
    "storage",
    "search",
    "favicon",
    "management",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Command palette (Cmd+Shift+P)"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open or close the command palette"
    }
  }
}
