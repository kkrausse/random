{
  "manifest_version": 3,
  "name": "Reading Context",
  "version": "0.1.13",
  "minimum_chrome_version": "116",
  "description": "Ask questions about highlighted passages using the Reading Context OpenCode server.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://raspberrypi.example.ts.net:41137/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Reading Context"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
