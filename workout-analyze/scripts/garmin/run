#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
VENV="$ROOT/.venv"
CLI="$VENV/bin/garmin-connect"

if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
fi

if [ ! -x "$CLI" ]; then
  "$VENV/bin/python" -m pip install "garmin-connect-cli==1.0.1"
fi

exec "$VENV/bin/python" "$CLI" "$@"
