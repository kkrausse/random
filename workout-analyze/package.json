{
  "name": "workout-analyze",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun run build:data && bun run build:analysis && bun --bun vite build",
    "build:app": "bun --bun vite build",
    "build:data": "bun run src/scripts/build-data.ts",
    "build:analysis": "bun run src/scripts/build-analysis.ts",
    "analysis:experiment": "bun run src/scripts/analysis-experiment.ts",
    "garmin:login": "scripts/garmin/run auth login",
    "garmin:sync": "bun run scripts/garmin/sync.ts",
    "preview": "bun --bun vite preview",
    "mobile:dev": "bun --bun vite --config mobile/vite.config.ts --host 0.0.0.0 --port 4317",
    "mobile:build": "bun run scripts/mobile/build.ts",
    "mobile:build:v2": "bun run scripts/mobile/build.ts --engine=v2",
    "mobile:typecheck": "tsc -p mobile/tsconfig.json --noEmit",
    "mobile:test": "bun test mobile scripts/mobile",
    "mobile:replay:check": "bun run scripts/mobile/check-local-replay.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@garmin/fitsdk": "^21.213.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^8.21.3",
    "effect": "^3.22.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
