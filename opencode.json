{
  "$schema": "https://opencode.ai/config.json",
  "tui": {
    "scroll_speed": 5
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git diff *": "allow",
      "bunx tsc *": "allow",
      "npx tsc *": "allow",
      "bun run typecheck *": "allow",
      "bun run format:check *": "allow",
      "bun run format *": "allow"
    },
    "webfetch": "ask"
  }
}
