{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "head *": "allow",
      "ls *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "git diff *": "allow",
      "bunx tsc *": "allow",
      "npx tsc *": "allow",
      "bun run build *": "allow",
      "bun run next *": "allow",
      "bun run typecheck *": "allow",
      "bun run format:check *": "allow",
      "bun run format *": "allow"
    },
    "webfetch": "ask"
  }
}
