{
  "mediaRoot": "/path/to/source-media",
  "derivedRoot": "/path/to/fieldcut/derived",
  "savedProjectsRoot": "/path/to/fieldcut/projects",
  "ffmpegPath": "/opt/homebrew/bin/ffmpeg",
  "thumbnail": {
    "maxWidth": 480,
    "quality": 3
  },
  "proxy": {
    "enabled": true,
    "maxHeight": 1080,
    "codec": "h264",
    "crf": 22,
    "audioCodec": "aac"
  },
  "export": {
    "codec": "h264",
    "quality": 18,
    "concurrency": 4
  }
}
