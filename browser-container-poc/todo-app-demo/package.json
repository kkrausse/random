{
  "name": "todo-app-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api 'bun --bun react-router dev' 'bun --watch server.ts'",
    "build": "bun --bun react-router build",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "bun --bun react-router typegen && tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.13.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
