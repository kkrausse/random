{
  "name": "vivari-feasibility-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun install --frozen-lockfile && bun scripts/vendor-npm.ts",
    "dev": "bun scripts/vendor-npm.ts && vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "bun scripts/vendor-npm.ts && tsc --noEmit && vite build",
    "qualify:sqlite": "bun scripts/qualify-sqlite.ts"
  },
  "dependencies": {
    "@vivari/core": "1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.49.1-build1",
    "@types/bun": "1.2.21",
    "npm": "10.9.2",
    "sql.js": "1.13.0",
    "typescript": "5.9.2",
    "vite": "7.1.4"
  }
}
