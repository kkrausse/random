{
  "manifest_version": 3,
  "name": "Super Extension",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Reading Context side panel (ask about highlighted passages via the Reading Context OpenCode server) plus a Cmd+Shift+P command palette that teaches Chrome's keyboard shortcuts.",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "tabs",
    "sessions",
    "bookmarks",
    "history",
    "search",
    "favicon",
    "clipboardWrite",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://raspberrypi.example.ts.net:41137/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Reading Context"
  },
  "commands": {
    "toggle-reading-context": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open or close Reading Context"
    },
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open or close the command palette"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
